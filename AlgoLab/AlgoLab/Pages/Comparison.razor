@page "/comparison"

@using Microsoft.JSInterop

@inject ExperimentHistoryService HistoryService
@inject IJSRuntime JS


<PageTitle>
    Сравнение экспериментов
</PageTitle>


<h2>
    Сравнение сохранённых экспериментов
</h2>


<p class="text-muted">

    Выберите два или более ранее выполненных эксперимента.
    Новые вычисления не выполняются — график строится
    непосредственно по данным из истории SQLite.

</p>


<div class="alert alert-info">

    Можно выбирать эксперименты разных алгоритмов
    и с разными диапазонами n.

    3D-эксперименты матриц в обычное линейное
    сравнение не включаются.

</div>


@if (loading)
{
    <div class="mt-4">

        <div class="spinner-border">
        </div>

        <span class="ms-2">
            Загрузка истории...
        </span>

    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">
        @error
    </div>
}
else if (available.Count == 0)
{
    <div class="alert alert-secondary">

        В истории пока нет подходящих
        2D-экспериментов.

    </div>
}
else
{
    <!-- ===================================== -->
    <!-- FILTER                              -->
    <!-- ===================================== -->

    <div class="row mb-3">

        <div class="col-md-6">

            <label class="form-label">
                Фильтр по алгоритму
            </label>


            <select class="form-select"
                    @bind="algorithmFilter">

                <option value="">
                    Все алгоритмы
                </option>


                @foreach (var name
                    in available
                        .Select(e => e.AlgorithmName)
                        .Distinct()
                        .OrderBy(n => n))
                {
                    <option value="@name">
                        @name
                    </option>
                }

            </select>

        </div>

    </div>


    <!-- ===================================== -->
    <!-- EXPERIMENTS                         -->
    <!-- ===================================== -->

    <div class="row">

        @foreach (var item
            in FilteredExperiments)
        {
            <div class="col-md-6 mb-3">

                <div class="
                    card
                    h-100
                    @(selectedIds.Contains(item.Id)
                        ? "border-primary"
                        : "")">

                    <div class="card-body">

                        <div class="
                            d-flex
                            justify-content-between">

                            <div class="form-check">

                                <input class="form-check-input"
                                       type="checkbox"
                                       checked="@selectedIds.Contains(item.Id)"
                                       @onchange="e => Toggle(
                                                                           item.Id,
                                                                           (bool)(e.Value ?? false))" />


<label class="form-check-label">

                                    <strong>
                                        @item.AlgorithmName
                                    </strong>

                                </label>

                            </div>


                            <span class="badge bg-primary">

                                @item.Complexity

                            </span>

                        </div>


                        <hr />


                        <div>

                            <strong>
                                ID:
                            </strong>

                            #@item.Id

                        </div>


                        <div>

                            <strong>
                                Дата:
                            </strong>

                            @(item.CreatedAt
                                .ToLocalTime()
                                .ToString(
                                    "dd.MM.yyyy HH:mm"))

                        </div>


                        <div>

                            <strong>
                                Max n:
                            </strong>

                            @item.MaxN

                        </div>


                        <div>

                            <strong>
                                Шаг:
                            </strong>

                            @item.Step

                        </div>


                        <div>

                            <strong>
                                R²:
                            </strong>

                            @item.R2.ToString("F4")

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>


    <div class="d-flex gap-2 mt-2">

        <button class="btn btn-primary"
                @onclick="Compare"
                disabled="@(selectedIds.Count < 2 || comparing)">

            @(comparing
                ? "Загрузка..."
                : $"Сравнить выбранные ({selectedIds.Count})")

        </button>


        <button class="btn btn-outline-secondary"
                @onclick="ClearSelection"
                disabled="@(selectedIds.Count == 0)">

            Очистить выбор

        </button>

    </div>


    @if (selectedIds.Count == 1)
    {
        <div class="text-muted mt-2">

            Выберите ещё хотя бы один эксперимент.

        </div>
    }


    <!-- ===================================== -->
    <!-- COMPARISON GRAPH                    -->
    <!-- ===================================== -->
    @if (comparisonReady)
    {
        <div class="mt-5">

            <h3>
                Результат сравнения
            </h3>


            <div id="@comparisonPlotId"
                 style="
                width:100%;
                min-height:600px;
                border:1px solid #e5e7eb;
                border-radius:8px;">
            </div>


            @if (!string.IsNullOrWhiteSpace(plotError))
            {
                <div class="alert alert-warning mt-2">

                    Ошибка графика:

                    @plotError

                </div>
            }


            <div class="mt-4">

                <h4>
                    Выбранные эксперименты
                </h4>


                <div class="table-responsive">

                    <table class="
                        table
                        table-striped
                        table-sm">

                        <thead>

                            <tr>

                                <th>
                                    ID
                                </th>

                                <th>
                                    Алгоритм
                                </th>

                                <th>
                                    Сложность
                                </th>

                                <th>
                                    Max n
                                </th>

                                <th>
                                    Точек
                                </th>

                                <th>
                                    R²
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item
                                in loadedExperiments)
                            {
                                <tr>

                                    <td>
                                        #@item.Id
                                    </td>

                                    <td>
                                        @item.AlgorithmName
                                    </td>

                                    <td>
                                        @item.Complexity
                                    </td>

                                    <td>
                                        @item.MaxN
                                    </td>

                                    <td>
                                        @GetAveragePoints(item).Count
                                    </td>

                                    <td>
                                        @item.R2.ToString("F4")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>


            <div class="alert alert-secondary mt-4">

                На графике используются сохранённые
                средние значения времени.

                Повторный запуск алгоритмов не производится.

            </div>

        </div>
    }
}


@code {

    // =====================================================
    // HISTORY
    // =====================================================

    private List<ExperimentDto> available =
        new();


    private HashSet<int> selectedIds =
        new();


    private List<ExperimentDto> loadedExperiments =
        new();


    // =====================================================
    // UI
    // =====================================================

    private bool loading =
        true;


    private bool comparing;


    private bool comparisonReady;


    private bool drawComparison;


    private string error =
        "";


    private string plotError =
        "";


    private string algorithmFilter =
        "";


    private readonly string comparisonPlotId =
        "history-comparison-"
        +
        Guid.NewGuid()
            .ToString("N");


    // =====================================================
    // FILTER
    // =====================================================

    private IEnumerable<ExperimentDto>
        FilteredExperiments =>
            available
                .Where(
                    e =>
                        string.IsNullOrWhiteSpace(
                            algorithmFilter)
                        ||
                        e.AlgorithmName
                            == algorithmFilter)
                .OrderByDescending(
                    e => e.CreatedAt);


    // =====================================================
    // LOAD HISTORY
    // =====================================================

    protected override async Task
        OnInitializedAsync()
    {
        try
        {
            loading =
                true;


            var all =
                await HistoryService
                    .GetAllAsync();


            // GetAll не загружает Points,
            // но для списка они и не нужны.
            //
            // Исключаем только новый 3D Matrix.

            available =
                all
                    .Where(
                        e =>
                            e.AlgorithmSlug
                            != "matrix-3d")
                    .OrderByDescending(
                        e => e.CreatedAt)
                    .ToList();
        }
        catch (Exception ex)
        {
            error =
                "Не удалось загрузить историю: "
                + ex.Message;
        }
        finally
        {
            loading =
                false;
        }
    }


    // =====================================================
    // SELECTION
    // =====================================================

    private void Toggle(
        int id,
        bool selected)
    {
        if (selected)
        {
            selectedIds.Add(
                id);
        }
        else
        {
            selectedIds.Remove(
                id);
        }


        comparisonReady =
            false;
    }


    private void ClearSelection()
    {
        selectedIds.Clear();

        loadedExperiments.Clear();

        comparisonReady =
            false;

        drawComparison =
            false;
    }


    // =====================================================
    // COMPARE
    // =====================================================

    private async Task Compare()
    {
        if (selectedIds.Count < 2)
            return;


        comparing =
            true;


        comparisonReady =
            false;


        drawComparison =
            false;


        plotError =
            "";


        loadedExperiments.Clear();


        try
        {

            foreach (int id
                in selectedIds)
            {
                var experiment =
                    await HistoryService
                        .GetByIdAsync(id);


                if (experiment is null)
                    continue;


                if (GetAveragePoints(
                        experiment)
                    .Count == 0)
                {
                    continue;
                }


                loadedExperiments.Add(
                    experiment);
            }


            if (loadedExperiments.Count < 2)
            {
                error =
                    "Не удалось получить как минимум "
                    + "два эксперимента с 2D-данными.";

                return;
            }


            comparisonReady =
                true;


            drawComparison =
                true;


            StateHasChanged();

            await Task.Yield();
        }
        catch (Exception ex)
        {
            error =
                "Ошибка сравнения: "
                + ex.Message;
        }
        finally
        {
            comparing =
                false;
        }
    }


    // =====================================================
    // DRAW
    // =====================================================

    protected override async Task
        OnAfterRenderAsync(
            bool firstRender)
    {
        if (!drawComparison)
            return;


        drawComparison =
            false;


        try
        {
            var series =
                loadedExperiments
                    .Select(
                        experiment =>
                            new
                            {
                                name =
                                    $"{experiment.AlgorithmName} "
                                    + $"#{experiment.Id}",

                                points =
                                    GetAveragePoints(
                                            experiment)
                                        .Select(
                                            p => new
                                            {
                                                n =
                                                    p.N,

                                                timeMs =
                                                    p.TimeMs
                                            })
                                        .ToArray()
                            })
                    .ToArray();


            await JS.InvokeVoidAsync(
                "algoLabPlotly.drawHistoryComparison",
                comparisonPlotId,
                series);
        }
        catch (Exception ex)
        {
            plotError =
                ex.Message;


            StateHasChanged();
        }
    }


    // =====================================================
    // POINTS
    // =====================================================

    private static List<ExperimentPointDto>
        GetAveragePoints(
            ExperimentDto experiment)
    {
        return experiment.Points
            .Where(
                p =>
                    p.IsAverage
                    &&
                    !p.Is3D)
            .OrderBy(
                p => p.N)
            .ToList();
    }
}