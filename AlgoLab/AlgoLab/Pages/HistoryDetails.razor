@page "/history/{Id:int}"

@using Microsoft.JSInterop

@inject ExperimentHistoryService HistoryService
@inject IJSRuntime JS


<PageTitle>
    Результат эксперимента
</PageTitle>


@if (loading)
{
    <div class="mt-4">

        <div class="spinner-border">
        </div>

        <span class="ms-2">
            Загрузка эксперимента...
        </span>

    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger mt-4">

        @errorMessage

    </div>


    <a href="/history"
       class="btn btn-secondary">

        ← Вернуться к истории

    </a>
}
else if (experiment is not null)
{
    <div>

        <!-- ===================================== -->
        <!-- HEADER                               -->
        <!-- ===================================== -->

        <a href="/history"
           class="btn btn-outline-secondary mb-4">

            ← История

        </a>


        <div class="
            d-flex
            justify-content-between
            align-items-start
            flex-wrap
            gap-3">


            <div>

                <h2>
                    @experiment.AlgorithmName
                </h2>


                <span class="badge bg-primary">

                    @experiment.Complexity

                </span>

            </div>


            <div class="text-muted">

                @experiment.CreatedAt
                .ToLocalTime()
                .ToString("dd.MM.yyyy HH:mm:ss")

            </div>


        </div>


        <hr class="my-4" />


        <!-- ===================================== -->
        <!-- PARAMETERS                           -->
        <!-- ===================================== -->

        <h4>
            Параметры эксперимента
        </h4>


        <div class="row mt-3">


            <div class="col-md-3 mb-3">

                <div class="card h-100">

                    <div class="card-body">

                        <small class="text-muted">
                            Максимальное n
                        </small>

                        <h4>
                            @experiment.MaxN
                        </h4>

                    </div>

                </div>

            </div>


            <div class="col-md-3 mb-3">

                <div class="card h-100">

                    <div class="card-body">

                        <small class="text-muted">
                            Шаг
                        </small>

                        <h4>
                            @experiment.Step
                        </h4>

                    </div>

                </div>

            </div>


            <div class="col-md-3 mb-3">

                <div class="card h-100">

                    <div class="card-body">

                        <small class="text-muted">
                            Запусков
                        </small>

                        <h4>
                            @experiment.Runs
                        </h4>

                    </div>

                </div>

            </div>


            <div class="col-md-3 mb-3">

                <div class="card h-100">

                    <div class="card-body">

                        <small class="text-muted">
                            Точек
                        </small>

                        <h4>
                            @AveragePoints.Count
                        </h4>

                    </div>

                </div>

            </div>


        </div>


        <!-- ===================================== -->
        <!-- 2D GRAPH                             -->
        <!-- ===================================== -->
        @if (AveragePoints.Count > 0)
        {
            <div class="mt-4">

                <ComplexityChart Experimental="@HistoryExperimentalPoints"
                                 Approximation="@HistoryApproximationPoints"
                                 Title="@GetGraphTitle()"
                                 ApproximationName="@GetApproximationName()"
                                 XAxisTitle="@GetXAxisTitle()"
                                 YAxisTitle="Среднее время выполнения, мс"
                                 Height="520" />

            </div>


            <!-- ================================= -->
            <!-- APPROXIMATION                   -->
            <!-- ================================= -->

            <div class="alert alert-light border mt-4">

                <h5>
                    Аппроксимация
                </h5>


                <div style="
                    font-family:monospace;
                    font-size:1.15rem;">

                    @GetApproximationFormula()

                </div>


                <div class="mt-3">

                    <strong>
                        Коэффициент C:
                    </strong>

                    @(experiment.ApproximationCoefficient.ToString("G6"))

                </div>


                <div>

                    <strong>
                        Коэффициент детерминации:
                    </strong>

                    R² =
                    @(experiment.R2.ToString("F4"))

                </div>


                <small class="text-muted">

                    Чем R² ближе к 1, тем лучше выбранная
                    теоретическая зависимость описывает
                    экспериментальные результаты.

                </small>

            </div>
        }
        else
        {
            <div class="alert alert-warning">

                У этого эксперимента отсутствуют
                сохранённые средние точки.

                Если это старая тестовая запись,
                выполните эксперимент повторно.

            </div>
        }


        <!-- ===================================== -->
        <!-- MATRIX 3D                           -->
        <!-- ===================================== -->
        @if (experiment.AlgorithmSlug == "matrix"
                     && IndividualPoints.Count > 0)
        {
            <div class="mt-5">

                <h4>
                    Сохранённый 3D-график
                </h4>


                <p class="text-muted">

                    X — размер матрицы n,
                    Y — номер запуска,
                    Z — время выполнения в миллисекундах.

                </p>


                <div id="@plotId"
                     style="
                    width:100%;
                    min-height:600px;
                    border:1px solid #e5e7eb;
                    border-radius:8px;">
                </div>

            </div>
        }


        <!-- ===================================== -->
        <!-- TABLE                                -->
        <!-- ===================================== -->
        @if (AveragePoints.Count > 0)
        {
            <div class="mt-5">

                <h4>
                    Результаты измерений
                </h4>


                <div class="table-responsive">

                    <table class="
                        table
                        table-striped
                        table-sm">


                        <thead>

                            <tr>

                                <th>
                                    n
                                </th>

                                <th>
                                    Среднее время, мс
                                </th>

                                <th>
                                    Аппроксимация, мс
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var point in AveragePoints)
                            {
                                <tr>

                                    <td>
                                        @point.N
                                    </td>

                                    <td>
                                        @(point.TimeMs.ToString("F6"))
                                    </td>

                                    <td>
                                        @(point.ApproximationTimeMs.ToString("F6"))
                                    </td>

                                </tr>
                            }

                        </tbody>


                    </table>

                </div>

            </div>
        }


        <!-- ===================================== -->
        <!-- MATRIX RUNS                         -->
        <!-- ===================================== -->
        @if (experiment.AlgorithmSlug == "matrix"
                     && IndividualPoints.Count > 0)
        {
            <div class="mt-5">

                <h4>
                    Отдельные запуски матриц
                </h4>


                <div class="table-responsive">

                    <table class="
                        table
                        table-striped
                        table-sm">


                        <thead>

                            <tr>

                                <th>
                                    n
                                </th>

                                <th>
                                    Запуск
                                </th>

                                <th>
                                    Время, мс
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var point in IndividualPoints)
                            {
                                <tr>

                                    <td>
                                        @point.N
                                    </td>

                                    <td>
                                        @point.Run
                                    </td>

                                    <td>
                                        @(point.TimeMs.ToString("F6"))
                                    </td>

                                </tr>
                            }

                        </tbody>


                    </table>

                </div>

            </div>
        }


    </div>
}


@code {

    // =====================================================
    // URL
    // =====================================================

    [Parameter]
    public int Id { get; set; }


    // =====================================================
    // STATE
    // =====================================================

    private ExperimentDto?
        experiment;


    private bool loading =
        true;


    private string errorMessage =
        "";


    // =====================================================
    // DATABASE POINTS
    // =====================================================

    private List<ExperimentPointDto> AveragePoints =>
        experiment?.Points
            .Where(p => p.IsAverage)
            .OrderBy(p => p.N)
            .ToList()
        ??
        new List<ExperimentPointDto>();


    private List<ExperimentPointDto> IndividualPoints =>
        experiment?.Points
            .Where(
                p =>
                    !p.IsAverage
                    &&
                    p.Run > 0)
            .OrderBy(p => p.N)
            .ThenBy(p => p.Run)
            .ToList()
        ??
        new List<ExperimentPointDto>();


    // =====================================================
    // POINTS FOR COMPLEXITY CHART
    // =====================================================

    private List<BenchmarkPoint> HistoryExperimentalPoints =>
        AveragePoints
            .Select(
                p => new BenchmarkPoint
                {
                    N =
                        p.N,

                    TimeMs =
                        p.TimeMs
                })
            .ToList();


    private List<BenchmarkPoint> HistoryApproximationPoints =>
        AveragePoints
            .Select(
                p => new BenchmarkPoint
                {
                    N =
                        p.N,

                    TimeMs =
                        p.ApproximationTimeMs
                })
            .ToList();


    // =====================================================
    // MATRIX 3D
    // =====================================================

    private readonly string plotId =
        "history-matrix-"
        +
        Guid.NewGuid()
            .ToString("N");


    private bool draw3D;


    // =====================================================
    // LOAD
    // =====================================================

    protected override async Task
        OnParametersSetAsync()
    {
        await Load();
    }


    private async Task Load()
    {
        try
        {
            loading =
                true;


            errorMessage =
                "";


            draw3D =
                false;


            experiment =
                await HistoryService
                    .GetByIdAsync(Id);


            if (experiment is null)
            {
                errorMessage =
                    "Эксперимент не найден.";

                return;
            }


            draw3D =
                experiment.AlgorithmSlug
                    == "matrix"
                &&
                IndividualPoints.Count
                    > 0;
        }
        catch (Exception ex)
        {
            errorMessage =
                "Не удалось загрузить эксперимент: "
                + ex.Message;
        }
        finally
        {
            loading =
                false;
        }
    }


    // =====================================================
    // 3D AFTER RENDER
    // =====================================================

    protected override async Task
        OnAfterRenderAsync(
            bool firstRender)
    {
        if (!draw3D)
            return;


        draw3D =
            false;


        var data =
            IndividualPoints
                .Select(
                    p => new
                    {
                        n =
                            p.N,

                        run =
                            p.Run,

                        timeMs =
                            p.TimeMs
                    })
                .ToArray();


        try
        {
            await JS.InvokeVoidAsync(
                "algoLabPlotly.drawMatrix3D",
                plotId,
                data);
        }
        catch (Exception ex)
        {
            errorMessage =
                "Ошибка 3D-графика: "
                + ex.Message;


            StateHasChanged();
        }
    }


    // =====================================================
    // LABELS
    // =====================================================

    private string GetGraphTitle()
    {
        if (experiment is null)
            return "Результат эксперимента";


        return experiment.AlgorithmName
               + " — сохранённый эксперимент";
    }


    private string GetXAxisTitle()
    {
        if (experiment?.AlgorithmSlug
            == "matrix")
        {
            return "Размер матрицы n";
        }


        if (experiment?.AlgorithmSlug
            == "tsp")
        {
            return "Количество городов n";
        }


        return "Размер входных данных n";
    }


    private string GetApproximationName()
    {
        return experiment?.AlgorithmSlug switch
        {
            "bubble" =>
                "Аппроксимация C·n²",

            "quick" =>
                "Аппроксимация C·n·log₂(n)",

            "timsort" =>
                "Аппроксимация C·n·log₂(n)",

            "matrix" =>
                "Аппроксимация C·n³",

            "tsp" =>
                "Аппроксимация C·(n−1)!",

            _ =>
                "Аппроксимация"
        };
    }


    private string GetApproximationFormula()
    {
        if (experiment is null)
            return "";


        string coefficient =
            experiment
                .ApproximationCoefficient
                .ToString("G6");


        return experiment.AlgorithmSlug switch
        {
            "bubble" =>
                $"T(n) ≈ {coefficient} · n²",

            "quick" =>
                $"T(n) ≈ {coefficient} · n · log₂(n)",

            "timsort" =>
                $"T(n) ≈ {coefficient} · n · log₂(n)",

            "matrix" =>
                $"T(n) ≈ {coefficient} · n³",

            "tsp" =>
                $"T(n) ≈ {coefficient} · (n−1)!",

            _ =>
                $"T(n) ≈ {coefficient} · f(n)"
        };
    }
}