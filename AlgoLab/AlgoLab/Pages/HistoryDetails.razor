@page "/history/{Id:int}"

@using Microsoft.JSInterop

@inject ExperimentHistoryService HistoryService
@inject IJSRuntime JS


<PageTitle>
    Результат эксперимента
</PageTitle>


@if (loading)
{
    <div class="mt-4">

        <div class="spinner-border">
        </div>

        <span class="ms-2">
            Загрузка эксперимента...
        </span>

    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger mt-4">
        @errorMessage
    </div>

    <a href="/history"
       class="btn btn-secondary">

        ← Вернуться к истории

    </a>
}
else if (experiment is not null)
{
    <div>

        <!-- ===================================== -->
        <!-- HEADER                               -->
        <!-- ===================================== -->

        <a href="/history"
           class="btn btn-outline-secondary mb-4">

            ← История

        </a>


        <div class="
            d-flex
            justify-content-between
            align-items-start
            flex-wrap
            gap-3">

            <div>

                <h2>
                    @experiment.AlgorithmName
                </h2>

                <span class="badge bg-primary">
                    @experiment.Complexity
                </span>

            </div>


            <div class="text-muted">

                @(experiment.CreatedAt
                    .ToLocalTime()
                    .ToString("dd.MM.yyyy HH:mm:ss"))

            </div>

        </div>


        <hr class="my-4" />


        <!-- ===================================== -->
        <!-- PARAMETERS                           -->
        <!-- ===================================== -->

        <h4>
            Параметры эксперимента
        </h4>


        <div class="row mt-3">

            <div class="col-md-3 mb-3">

                <div class="card h-100">
                    <div class="card-body">

                        <small class="text-muted">
                            Максимальное n
                        </small>

                        <h4>
                            @experiment.MaxN
                        </h4>

                    </div>
                </div>

            </div>


            <div class="col-md-3 mb-3">

                <div class="card h-100">
                    <div class="card-body">

                        <small class="text-muted">
                            Шаг n
                        </small>

                        <h4>
                            @experiment.Step
                        </h4>

                    </div>
                </div>

            </div>


            <div class="col-md-3 mb-3">

                <div class="card h-100">
                    <div class="card-body">

                        <small class="text-muted">
                            Запусков
                        </small>

                        <h4>
                            @experiment.Runs
                        </h4>

                    </div>
                </div>

            </div>


            <div class="col-md-3 mb-3">

                <div class="card h-100">
                    <div class="card-body">

                        <small class="text-muted">
                            Точек
                        </small>

                        <h4>
                            @DisplayedPointCount
                        </h4>

                    </div>
                </div>

            </div>

        </div>


        <!-- ===================================== -->
        <!-- NORMAL 2D EXPERIMENT                 -->
        <!-- ===================================== -->
        @if (!IsMatrix3D &&
                     AveragePoints.Count > 0)
        {
            <div class="mt-4">

                <ComplexityChart Experimental="@HistoryExperimentalPoints"
                                 Approximation="@HistoryApproximationPoints"
                                 Title="@GetGraphTitle()"
                                 ApproximationName="@GetApproximationName()"
                                 XAxisTitle="@GetXAxisTitle()"
                                 YAxisTitle="Среднее время выполнения, мс"
                                 Height="520" />

            </div>


            <div class="alert alert-light border mt-4">

                <h5>
                    Аппроксимация
                </h5>


                <div style="
                    font-family:monospace;
                    font-size:1.15rem;">

                    @GetApproximationFormula()

                </div>


                <div class="mt-3">

                    <strong>
                        Коэффициент C:
                    </strong>

                    @(experiment
                        .ApproximationCoefficient
                        .ToString("G6"))

                </div>


                <div>

                    <strong>
                        Коэффициент детерминации:
                    </strong>

                    R² =
                    @(experiment.R2.ToString("F4"))

                </div>

            </div>


            <div class="mt-5">

                <h4>
                    Результаты измерений
                </h4>


                <div class="table-responsive">

                    <table class="
                        table
                        table-striped
                        table-sm">

                        <thead>

                            <tr>

                                <th>
                                    n
                                </th>

                                <th>
                                    Среднее время, мс
                                </th>

                                <th>
                                    Аппроксимация, мс
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var point
                                in AveragePoints)
                            {
                                <tr>

                                    <td>
                                        @point.N
                                    </td>

                                    <td>
                                        @(point
                                            .TimeMs
                                            .ToString("F6"))
                                    </td>

                                    <td>
                                        @(point
                                            .ApproximationTimeMs
                                            .ToString("F6"))
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }


        <!-- ===================================== -->
        <!-- MATRIX 3D                            -->
        <!-- ===================================== -->
        @if (IsMatrix3D)
        {
            if (SurfacePoints.Count > 0)
            {
                <div class="mt-4">

                    <h4>
                        Сохранённая 3D-поверхность
                    </h4>


                    <p class="text-muted">

                        <strong>X:</strong>
                        размер n

                        <br />

                        <strong>Y:</strong>
                        размер m

                        <br />

                        <strong>Z:</strong>
                        среднее время выполнения, мс

                    </p>


                    <div id="@surfaceId"
                         style="
                        width:100%;
                        min-height:650px;
                        border:1px solid #e5e7eb;
                        border-radius:8px;">
                    </div>


                    @if (!string.IsNullOrWhiteSpace(plotError))
                    {
                        <div class="
                            alert
                            alert-warning
                            mt-2">

                            Ошибка восстановления поверхности:

                            @plotError

                        </div>
                    }


                    <div class="
                        alert
                        alert-secondary
                        mt-4">

                        Для матриц

                        <strong>
                            A(n×m)
                        </strong>

                        и

                        <strong>
                            B(m×n)
                        </strong>

                        вычисляется n² элементов результата.

                        Каждый элемент требует m умножений.

                        <br /><br />

                        Поэтому:

                        <strong>
                            T(n,m) = O(n²·m)
                        </strong>.

                        При n = m получаем

                        <strong>
                            O(n³)
                        </strong>.

                    </div>


                    <div class="mt-4">

                        <h4>
                            Сохранённые точки поверхности
                        </h4>


                        <div class="table-responsive">

                            <table class="
                                table
                                table-striped
                                table-sm">

                                <thead>

                                    <tr>

                                        <th>
                                            n
                                        </th>

                                        <th>
                                            m
                                        </th>

                                        <th>
                                            Среднее время, мс
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var point
                                        in SurfacePoints)
                                    {
                                        <tr>

                                            <td>
                                                @point.N
                                            </td>

                                            <td>
                                                @point.M
                                            </td>

                                            <td>
                                                @(point
                                                    .TimeMs
                                                    .ToString("F6"))
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="alert alert-warning mt-4">

                    В этой записи отсутствуют сохранённые
                    точки 3D-поверхности.

                    Если запись была создана до обновления
                    формата базы данных, выполните
                    эксперимент повторно.

                </div>
            }
        }


        <!-- ===================================== -->
        <!-- OLD DATA FALLBACK                    -->
        <!-- ===================================== -->
        @if (!IsMatrix3D &&
                     AveragePoints.Count == 0)
        {
            <div class="alert alert-warning mt-4">

                В этой записи отсутствуют сохранённые
                средние точки.

                Вероятно, это старая тестовая запись.

            </div>
        }

    </div>
}


@code {

    // =====================================================
    // URL
    // =====================================================

    [Parameter]
    public int Id { get; set; }


    // =====================================================
    // STATE
    // =====================================================

    private ExperimentDto?
        experiment;


    private bool loading =
        true;


    private string errorMessage =
        "";


    private string plotError =
        "";


    // =====================================================
    // TYPE
    // =====================================================

    private bool IsMatrix3D =>
        experiment?.AlgorithmSlug
        == "matrix-3d";


    // =====================================================
    // ORDINARY 2D POINTS
    // =====================================================

    private List<ExperimentPointDto>
        AveragePoints =>
            experiment?.Points
                .Where(
                    p =>
                        p.IsAverage
                        &&
                        !p.Is3D)
                .OrderBy(
                    p => p.N)
                .ToList()
            ??
            new List<ExperimentPointDto>();


    // =====================================================
    // SURFACE POINTS
    // =====================================================

    private List<ExperimentPointDto>
        SurfacePoints =>
            experiment?.Points
                .Where(
                    p => p.Is3D)
                .OrderBy(
                    p => p.N)
                .ThenBy(
                    p => p.M)
                .ToList()
            ??
            new List<ExperimentPointDto>();


    private int DisplayedPointCount =>
        IsMatrix3D
            ? SurfacePoints.Count
            : AveragePoints.Count;


    // =====================================================
    // COMPLEXITY CHART POINTS
    // =====================================================

    private List<BenchmarkPoint>
        HistoryExperimentalPoints =>
            AveragePoints
                .Select(
                    p => new BenchmarkPoint
                    {
                        N = p.N,

                        TimeMs =
                            p.TimeMs
                    })
                .ToList();


    private List<BenchmarkPoint>
        HistoryApproximationPoints =>
            AveragePoints
                .Select(
                    p => new BenchmarkPoint
                    {
                        N = p.N,

                        TimeMs =
                            p.ApproximationTimeMs
                    })
                .ToList();


    // =====================================================
    // SURFACE
    // =====================================================

    private readonly string surfaceId =
        "history-surface-"
        +
        Guid.NewGuid()
            .ToString("N");


    private bool drawSurface;


    // =====================================================
    // LOAD
    // =====================================================

    protected override async Task
        OnParametersSetAsync()
    {
        await Load();
    }


    private async Task Load()
    {
        try
        {
            loading =
                true;


            errorMessage =
                "";


            plotError =
                "";


            drawSurface =
                false;


            experiment =
                await HistoryService
                    .GetByIdAsync(Id);


            if (experiment is null)
            {
                errorMessage =
                    "Эксперимент не найден.";

                return;
            }


            drawSurface =
                IsMatrix3D
                &&
                SurfacePoints.Count > 0;
        }
        catch (Exception ex)
        {
            errorMessage =
                "Не удалось загрузить эксперимент: "
                + ex.Message;
        }
        finally
        {
            loading =
                false;
        }
    }


    // =====================================================
    // DRAW SURFACE AFTER DOM EXISTS
    // =====================================================

    protected override async Task
        OnAfterRenderAsync(
            bool firstRender)
    {
        if (!drawSurface)
            return;


        drawSurface =
            false;


        try
        {
            var nValues =
                SurfacePoints
                    .Select(
                        p => p.N)
                    .Distinct()
                    .OrderBy(
                        n => n)
                    .ToList();


            var mValues =
                SurfacePoints
                    .Select(
                        p => p.M)
                    .Distinct()
                    .OrderBy(
                        m => m)
                    .ToList();


            var z =
                new double[
                    mValues.Count][];


            for (int mIndex = 0;
                 mIndex < mValues.Count;
                 mIndex++)
            {
                int m =
                    mValues[mIndex];


                z[mIndex] =
                    new double[
                        nValues.Count];


                for (int nIndex = 0;
                     nIndex < nValues.Count;
                     nIndex++)
                {
                    int n =
                        nValues[nIndex];


                    var point =
                        SurfacePoints
                            .FirstOrDefault(
                                p =>
                                    p.N == n
                                    &&
                                    p.M == m);


                    z[mIndex][nIndex] =
                        point?.TimeMs
                        ?? 0;
                }
            }


            await JS.InvokeVoidAsync(
                "algoLabPlotly.drawMatrixSurface",
                surfaceId,
                nValues,
                mValues,
                z);
        }
        catch (Exception ex)
        {
            plotError =
                ex.Message;


            StateHasChanged();
        }
    }


    // =====================================================
    // LABELS
    // =====================================================

    private string GetGraphTitle()
    {
        return experiment is null
            ? "Результат эксперимента"
            : experiment.AlgorithmName
              + " — сохранённый эксперимент";
    }


    private string GetXAxisTitle()
    {
        return experiment?.AlgorithmSlug switch
        {
            "matrix" =>
                "Размер матрицы n",

            "tsp" =>
                "Количество городов n",

            _ =>
                "Размер входных данных n"
        };
    }


    private string GetApproximationName()
    {
        return experiment?.AlgorithmSlug switch
        {
            "bubble" =>
                "Аппроксимация C·n²",

            "quick" =>
                "Аппроксимация C·n·log₂(n)",

            "timsort" =>
                "Аппроксимация C·n·log₂(n)",

            "matrix" =>
                "Аппроксимация C·n³",

            "tsp" =>
                "Аппроксимация C·(n−1)!",

            _ =>
                "Аппроксимация"
        };
    }


    private string GetApproximationFormula()
    {
        if (experiment is null)
            return "";


        string c =
            experiment
                .ApproximationCoefficient
                .ToString("G6");


        return experiment.AlgorithmSlug switch
        {
            "bubble" =>
                $"T(n) ≈ {c} · n²",

            "quick" =>
                $"T(n) ≈ {c} · n · log₂(n)",

            "timsort" =>
                $"T(n) ≈ {c} · n · log₂(n)",

            "matrix" =>
                $"T(n) ≈ {c} · n³",

            "tsp" =>
                $"T(n) ≈ {c} · (n−1)!",

            _ =>
                $"T(n) ≈ {c} · f(n)"
        };
    }
}