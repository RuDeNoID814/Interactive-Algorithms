@page "/"

<div class="home-header">

    <h1>Interactive Algorithms</h1>

    <p>
        Лабораторная работа №1 — эмпирический анализ
        временной сложности алгоритмов
    </p>

</div>


@foreach (var category in
    AlgorithmRegistry.All
        .GroupBy(a => a.Category))
{
    <div class="mt-4">

        <h4 class="mb-3">
            @category.Key
        </h4>

        <div class="algo-grid">

            @foreach (var algo in category)
            {
                <a href="@($"/algorithm/{algo.Slug}")"
                   class="algo-card">

                    <div class="algo-card-complexity">
                        @algo.Complexity
                    </div>

                    <h5>
                        @algo.Name
                    </h5>

                    <p>
                        @algo.Description
                    </p>

                </a>
            }

        </div>

    </div>
}