@page "/algorithm/{Slug}"
@using AlgoLab.Labs.Lab1.Basics
@using AlgoLab.Labs.Lab1.Graphs
@using AlgoLab.Labs.Lab1.Matrix
@using AlgoLab.Labs.Lab1.Polynomials
@using AlgoLab.Labs.Lab1.Powers
@using AlgoLab.Labs.Lab1.Sorting
@using AlgoLab.Labs.Lab1
@using AlgoLab.Labs.Lab2.DragonCurve
@using AlgoLab.Labs.Lab2.HanoiTowers
@using AlgoLab.Labs.Lab3.Stack
@using AlgoLab.Labs.Lab3.Stack.Calculator
@using AlgoLab.Labs.Lab3.Stack.Brackets
@using AlgoLab.Labs.Lab3.SingleLinkedList.UI

@if (algo is null)
{
    <h3>Алгоритм не найден</h3>
    <a href="/">← Назад</a>
}
else
{
    <div class="algo-page-header">
        <a href="/" class="back-link">← Все алгоритмы</a>
        <span class="algo-page-complexity">@algo.Complexity</span>
        <h2>@algo.Name</h2>
        <p class="algo-page-desc">@algo.Description</p>
    </div>

    <div class="algo-interactive">

    @if (Slug == "bubble")
    {
        <BubbleSort />
    }
        else if (Slug == "quick")
        {
            <QuickSort />
        }
        else if (Slug == "timsort")
        {
            <TimSort />
        }
        else if (Slug == "matrix")
        {
            <MatrixMultiply />
        }
        else if (Slug == "const")
        {
            <ConstantFunction />
        }
        else if (Slug == "pow-simple")
        {
            <PowSimple />
        }
        else if (Slug == "pow-recursive")
        {
            <PowRecursive />
        }
        else if (Slug == "pow-fast")
        {
            <PowFast />
        }
        else if (Slug == "huffman")
        {
            <Huffman />
        }
        else if (Slug == "sum")
        {
            <SumElements />
        }
        else if (Slug == "product")
        {
            <ProductElements />
        }
        else if (Slug == "horner")
        {
            <Horner />
        }
        else if (Slug == "poly-naive")
        {
            <PolyNaive />
        }
        else if (Slug == "tsp")
        {
            <Tsp />
        }
        else if (Slug == "bfs")
        {
            <Bfs />
        }
        else if (Slug == "dragon-curve")
        {
            <DragonCurve />
        }
        else if (Slug == "hanoi")
        {
            <HanoiTowers />
        }
        else if (Slug == "stack")
        {
            <StackPage />
        }
        else if (Slug == "postfix")
        {
            <PostfixCalc />
        }
        else if (Slug == "list")
        {
            <ListWorkbench />
        }
        else if (Slug == "brackets")
        {
            <BracketChecker />
        }
        else
    {
        <div class="algo-placeholder">
            <p>
                Интерактивная часть для
                <strong>@algo.Name</strong>
                ещё не реализована.
            </p>
        </div>
    }

</div>
}

@code {

    [Parameter]
    public string Slug { get; set; } = "";

    private AlgorithmInfo? algo;


    protected override void OnParametersSet()
    {
        algo = AlgorithmRegistry.Find(Slug);
    }
}
