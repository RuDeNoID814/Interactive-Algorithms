@page "/algorithm/{Slug}"

@if (algo is null)
{
    <h3>Алгоритм не найден</h3>
    <a href="/">← Назад</a>
}
else
{
    <div class="algo-page-header">
        <a href="/" class="back-link">← Все алгоритмы</a>
        <span class="algo-page-complexity">@algo.Complexity</span>
        <h2>@algo.Name</h2>
        <p class="algo-page-desc">@algo.Description</p>
    </div>

    <div class="algo-interactive">

    @if (Slug == "bubble")
    {
        <BubbleSort />
    }
        else if (Slug == "quick")
        {
            <QuickSort />
        }
        else if (Slug == "timsort")
        {
            <TimSort />
        }
        else if (Slug == "matrix")
        {
            <MatrixMultiply />
        }
        else if (Slug == "const")
        {
            <ConstantFunction />
        }
        else if (Slug == "pow-simple")
        {
            <PowSimple />
        }
        else if (Slug == "pow-recursive")
        {
            <PowRecursive />
        }
        else if (Slug == "pow-fast")
        {
            <PowFast />
        }
        else if (Slug == "pow-classic")
        {
            <PowClassical />
        }
        else if (Slug == "sum")
        {
            <SumElements />
        }
        else if (Slug == "product")
        {
            <ProductElements />
        }
        else if (Slug == "horner")
        {
            <Horner />
        }
        else if (Slug == "poly-naive")
        {
            <PolyNaive />
        }
        else
    {
        <div class="algo-placeholder">
            <p>
                Интерактивная часть для
                <strong>@algo.Name</strong>
                ещё не реализована.
            </p>
        </div>
    }

</div>
}

@code {

    [Parameter]
    public string Slug { get; set; } = "";

    private AlgorithmInfo? algo;


    protected override void OnParametersSet()
    {
        algo = AlgorithmRegistry.Find(Slug);
    }
}
