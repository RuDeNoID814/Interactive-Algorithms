@using System.Diagnostics
@using System.Numerics

<div>

    <h3>Быстрое возведение в степень</h3>

    <p>
        Бинарный алгоритм (exponentiation by squaring). Показатель
        степени просматривается по битам справа налево: на каждом
        шаге основание возводится в квадрат, а результат домножается
        на текущее основание, если соответствующий бит равен 1.
    </p>

    <div class="alert alert-info">
        <strong>Лучший случай:</strong> O(log n)
        <br />
        <strong>Средний случай:</strong> O(log n)
        <br />
        <strong>Худший случай:</strong> O(log n)
        <br />
        <strong>Дополнительная память:</strong> O(1)
    </div>

    <!-- ====================================== -->
    <!-- ВИЗУАЛИЗАЦИЯ                          -->
    <!-- ====================================== -->

    <h4 class="mt-4">Визуализация алгоритма</h4>

    <div class="mb-3">
        <label class="form-label">
            Основание a: <strong>@baseValue</strong>
        </label>
        <input type="range"
               class="form-range"
               min="2" max="9"
               @bind="baseValue"
               disabled="@isRunning" />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Показатель n: <strong>@exponent</strong>
        </label>
        <input type="range"
               class="form-range"
               min="1" max="64"
               @bind="exponent"
               disabled="@isRunning" />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Скорость анимации: <strong>@GetSpeedText()</strong>
        </label>
        <input type="range"
               class="form-range"
               min="1" max="5"
               @bind="animationSpeed"
               disabled="@isRunning" />
    </div>

    <div class="d-flex gap-2 mb-4">
        <button class="btn btn-secondary"
                @onclick="Reset"
                disabled="@isRunning">
            Сброс
        </button>
        <button class="btn btn-primary"
                @onclick="StartAnimated"
                disabled="@(isRunning || isFinished)">
            @(isRunning ? "Выполняется..." : "Вычислить")
        </button>
    </div>

    <div class="d-flex flex-wrap gap-4 mb-3">
        <span><span style="color:#6366f1">■</span> Ожидает</span>
        <span><span style="color:#ef4444">■</span> Текущий бит</span>
        <span><span style="color:#22c55e">■</span> Обработан</span>
    </div>

    <div class="mb-3">
        <strong>Биты показателя n (MSB → LSB):</strong>

        <div class="d-flex gap-1 mt-2">
            @for (int i = 0; i < bitString.Length; i++)
            {
                int displayIdx = i;
                int bitPos = bitString.Length - 1 - i;
                <div style="
                    width:28px;
                    height:28px;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    border-radius:4px;
                    font-weight:600;
                    color:white;
                    background-color:@GetBitColor(bitPos);
                    transition:background-color 0.15s ease;">
                    @bitString[displayIdx]
                </div>
            }
        </div>
    </div>

    <div class="text-center mt-3">
        @if (isRunning)
        {
            <span>
                Шаг <strong>@currentStep</strong> из @totalSteps
                &nbsp;|&nbsp;
                Текущий бит: <strong>@currentBit</strong>
            </span>
        }
        else if (isFinished)
        {
            <strong class="text-success">Готово</strong>
        }
        else
        {
            <span class="text-muted">Нажмите «Вычислить»</span>
        }
    </div>

    <div class="row mt-4">

        <div class="col-md-4 mb-2">
            <div class="card h-100">
                <div class="card-body">
                    <small class="text-muted">Умножений</small>
                    <h4>@multiplications</h4>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-2">
            <div class="card h-100">
                <div class="card-body">
                    <small class="text-muted">Текущий результат</small>
                    <h4 style="word-break:break-all; font-size:1rem">
                        @FormatBig(currentResult)
                    </h4>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-2">
            <div class="card h-100">
                <div class="card-body">
                    <small class="text-muted">Длина результата</small>
                    <h4>@resultDigits цифр</h4>
                </div>
            </div>
        </div>

    </div>

    <!-- ====================================== -->
    <!-- ЭКСПЕРИМЕНТ                           -->
    <!-- ====================================== -->

    <hr class="my-5" />

    <h3>Экспериментальный анализ</h3>

    <p>
        Для каждого показателя n алгоритм выполняется 5 раз
        (основание фиксировано, a = 2), измеряется среднее
        машинное время.
    </p>

    <div class="row">

        <div class="col-md-4 mb-3">
            <label class="form-label">Максимальное n</label>
            <input type="number"
                   class="form-control"
                   min="10" max="2000"
                   @bind="benchmarkMaxN"
                   disabled="@benchmarkRunning" />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Шаг</label>
            <input type="number"
                   class="form-control"
                   min="1" max="500"
                   @bind="benchmarkStep"
                   disabled="@benchmarkRunning" />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Запусков</label>
            <input class="form-control" value="5" disabled />
        </div>

    </div>

    <button class="btn btn-success"
            @onclick="RunBenchmark"
            disabled="@benchmarkRunning">
        @(benchmarkRunning
            ? "Эксперимент выполняется..."
            : "Провести эксперимент")
    </button>

    @if (benchmarkRunning)
    {
        <div class="mt-3">
            <div class="spinner-border spinner-border-sm"></div>
            <span class="ms-2">Выполняется n = @currentBenchmarkN</span>
        </div>
    }

    @if (benchmarkResults.Count > 0)
    {
        <div class="mt-5">

            <h4>Зависимость времени выполнения от n</h4>

            <ApexChart TItem="BenchmarkPoint" Height="400">

                <ApexPointSeries TItem="BenchmarkPoint"
                                 Items="benchmarkResults"
                                 Name="Эксперимент"
                                 SeriesType="SeriesType.Line"
                                 XValue="@(p => p.N)"
                                 YValue="@(p => (decimal)p.TimeMs)" />

                <ApexPointSeries TItem="BenchmarkPoint"
                                 Items="theoreticalResults"
                                 Name="Теория O(log n)"
                                 SeriesType="SeriesType.Line"
                                 XValue="@(p => p.N)"
                                 YValue="@(p => (decimal)p.TimeMs)" />

            </ApexChart>

            <div class="alert alert-secondary mt-4">
                <strong>Теоретический анализ</strong>
                <p class="mt-2 mb-1">
                    Показатель степени обрабатывается по битам,
                    количество итераций равно <em>⌊log₂ n⌋ + 1</em>.
                </p>
                <p class="mb-0">
                    Асимптотическая сложность — <strong>O(log n)</strong>
                    умножений.
                </p>
            </div>

        </div>
    }

</div>

@code {

    private int baseValue = 2;
    private int exponent = 32;
    private int animationSpeed = 3;

    private bool isRunning;
    private bool isFinished;

    private int currentStep;
    private int totalSteps;
    private int currentBitIndex;
    private int currentBit;

    private long multiplications;

    private BigInteger currentResult = 1;
    private BigInteger currentBase = 1;
    private int resultDigits = 1;

    private string bitString = "0";


    private void Reset()
    {
        currentStep = 0;
        currentBitIndex = 0;
        currentBit = 0;
        multiplications = 0;
        currentResult = 1;
        currentBase = baseValue;
        resultDigits = 1;
        isFinished = false;

        bitString = Convert.ToString(exponent, 2);

        totalSteps = 0;
        int tmp = exponent;
        while (tmp > 0)
        {
            totalSteps++;
            tmp >>= 1;
        }
    }


    private async Task StartAnimated()
    {
        if (isRunning)
            return;

        Reset();

        isRunning = true;

        currentResult = 1;
        currentBase = baseValue;

        StateHasChanged();
        await Task.Delay(GetDelay());

        int n = exponent;
        int step = 0;

        while (n > 0)
        {
            step++;
            currentStep = step;
            currentBit = n & 1;

            if (currentBit == 1)
            {
                currentResult *= currentBase;
                multiplications++;
                resultDigits = currentResult.ToString().Length;

                StateHasChanged();
                await Task.Delay(GetDelay());
            }

            currentBase *= currentBase;
            multiplications++;

            currentBitIndex++;

            StateHasChanged();
            await Task.Delay(GetDelay());

            n >>= 1;
        }

        isRunning = false;
        isFinished = true;

        StateHasChanged();
    }


    private string GetBitColor(int bitPosFromLsb)
    {
        if (isFinished)
            return "#22c55e";

        if (isRunning && bitPosFromLsb == currentBitIndex)
            return "#ef4444";

        if (isRunning && bitPosFromLsb < currentBitIndex)
            return "#22c55e";

        return "#6366f1";
    }


    private static string FormatBig(BigInteger value)
    {
        var s = value.ToString();
        if (s.Length <= 40)
            return s;
        return s[..20] + "…" + s[^20..];
    }


    private int GetDelay() => animationSpeed switch
    {
        1 => 600,
        2 => 350,
        3 => 180,
        4 => 80,
        5 => 20,
        _ => 180
    };


    private string GetSpeedText() => animationSpeed switch
    {
        1 => "Очень медленно",
        2 => "Медленно",
        3 => "Средне",
        4 => "Быстро",
        5 => "Очень быстро",
        _ => "Средне"
    };


    // ==========================================
    // BENCHMARK
    // ==========================================

    private class BenchmarkPoint
    {
        public int N { get; set; }
        public double TimeMs { get; set; }
    }

    private int benchmarkMaxN = 500;
    private int benchmarkStep = 50;
    private int currentBenchmarkN;
    private bool benchmarkRunning;

    private List<BenchmarkPoint> benchmarkResults = new();
    private List<BenchmarkPoint> theoreticalResults = new();


    private async Task RunBenchmark()
    {
        if (benchmarkRunning)
            return;

        if (benchmarkMaxN < 1 || benchmarkStep < 1)
            return;

        if (benchmarkMaxN > 2000)
            benchmarkMaxN = 2000;

        benchmarkRunning = true;

        benchmarkResults.Clear();
        theoreticalResults.Clear();

        StateHasChanged();
        await Task.Yield();

        const int benchBase = 2;

        for (int n = benchmarkStep; n <= benchmarkMaxN; n += benchmarkStep)
        {
            currentBenchmarkN = n;

            double total = 0;

            for (int run = 0; run < 5; run++)
            {
                var sw = Stopwatch.StartNew();
                FastPower(benchBase, n);
                sw.Stop();
                total += sw.Elapsed.TotalMilliseconds;
            }

            benchmarkResults.Add(new BenchmarkPoint
            {
                N = n,
                TimeMs = total / 5.0
            });

            StateHasChanged();
            await Task.Yield();
        }

        BuildTheoreticalCurve();

        currentBenchmarkN = 0;
        benchmarkRunning = false;

        StateHasChanged();
    }


    private static BigInteger FastPower(int a, int n)
    {
        BigInteger result = 1;
        BigInteger b = a;

        while (n > 0)
        {
            if ((n & 1) == 1)
                result *= b;

            b *= b;
            n >>= 1;
        }

        return result;
    }


    private void BuildTheoreticalCurve()
    {
        theoreticalResults.Clear();

        if (benchmarkResults.Count == 0)
            return;

        double num = 0, den = 0;

        foreach (var p in benchmarkResults)
        {
            double t = Math.Log2(Math.Max(2, p.N));
            num += p.TimeMs * t;
            den += t * t;
        }

        double c = den == 0 ? 0 : num / den;

        foreach (var p in benchmarkResults)
        {
            double t = Math.Log2(Math.Max(2, p.N));
            theoreticalResults.Add(new BenchmarkPoint
            {
                N = p.N,
                TimeMs = c * t
            });
        }
    }

}