@using System.Diagnostics
@inject ExperimentSaveService SaveService

<h3>Простое возведение в степень</h3>

<p>
    Простой итеративный алгоритм: значение <em>x</em> возводится
    в степень <em>n</em> последовательным умножением в цикле
    (ровно <em>n</em> умножений).
</p>

<div class="alert alert-info">
    <strong>Сложность:</strong> O(n)<br />
    <strong>Количество умножений:</strong> n<br />
    <strong>Память:</strong> O(1)
</div>

<hr />

<h3>Экспериментальный анализ</h3>

<div class="row">
    <div class="col-md-6 mb-3">
        <label>Максимальное n</label>
        <input type="number" min="1" class="form-control"
               @bind="maxN" disabled="@running" />
    </div>

    <div class="col-md-6 mb-3">
        <label>Шаг</label>
        <input type="number" min="1" class="form-control"
               @bind="step" disabled="@running" />
    </div>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

<button class="btn btn-success"
        @onclick="Run"
        disabled="@running">
    @(running ? "Выполняется..." : "Запустить эксперимент")
</button>

@if (running)
{
    <div class="mt-4">
        <div class="d-flex justify-content-between">
            <span>n = @currentN</span>
            <strong>@progress.ToString("F1")%</strong>
        </div>

        <div class="progress mt-2" style="height:25px">
            <div class="progress-bar progress-bar-striped progress-bar-animated"
                 style="@ProgressStyle">
                @progress.ToString("F0")%
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(saved))
{
    <div class="alert alert-success mt-3">
        @saved
        <a href="/history" class="alert-link ms-2">История</a>
    </div>
}

@if (points.Count > 0)
{
    <div class="mt-5">

        <ComplexityChart Experimental="@points"
                         Approximation="@approximation.Points"
                         Title="Простое возведение в степень — число шагов"
                         ApproximationName="Аппроксимация C·n"
                         XAxisTitle="Показатель степени n"
                         YAxisTitle="Количество шагов (умножений)"
                         Height="520" />

        <div class="alert alert-light border mt-4">
            <strong>Аппроксимация:</strong><br />
            T(n) ≈ @approximation.Coefficient.ToString("G6") · n<br />
            R² = @approximation.R2.ToString("F4")
        </div>

        <div class="alert alert-secondary">
            В простом итеративном алгоритме выполняется ровно n умножений.
            Следовательно, временная сложность составляет <strong>O(n)</strong>.
        </div>
    </div>
}

@code {
    private int maxN = 10000;
    private int step = 500;

    private int currentN;
    private double progress;
    private bool running;

    private string error = "";
    private string saved = "";

    private List<BenchmarkPoint> points = new();
    private ApproximationResult approximation = new();

    private const long BaseX = 2;
    private const long Mod = 1_000_000_007; // защита от переполнения

    private async Task Run()
    {
        if (running) return;

        error = "";
        saved = "";

        if (maxN < 1 || step < 1)
        {
            error = "n и шаг должны быть больше нуля.";
            return;
        }

        running = true;
        points.Clear();

        var sizes = BuildSizes(maxN, step);
        int completed = 0;

        try
        {
            foreach (int n in sizes)
            {
                currentN = n;

                long steps = CountSteps(BaseX, n);

                points.Add(new BenchmarkPoint
                {
                    N = n,
                    TimeMs = steps
                });

                completed++;

                progress = (double)completed * 100 / sizes.Count;
                StateHasChanged();
                await Task.Yield();
            }

            approximation = ApproximationService.Fit(
                points,
                ComplexityType.Linear);

            await SaveService.SaveAsync(
                "power-simple",
                "Простое возведение в степень",
                "O(n)",
                maxN,
                step,
                1,
                points,
                approximation);

            saved = "Эксперимент сохранён.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            progress = 100;
            running = false;
            currentN = 0;
        }
    }

    private static long CountSteps(long x, int n)
    {
        long result = 1;
        long steps = 0;

        for (int i = 0; i < n; i++)
        {
            result = (result * x) % Mod;
            steps++;
        }

        return steps;
    }

    private static List<int> BuildSizes(int max, int step)
    {
        var result = new List<int>();

        for (int n = 1; n <= max; n += step)
            result.Add(n);

        if (result.Count == 0 || result[^1] != max)
            result.Add(max);

        return result;
    }

    private string ProgressStyle =>
        $"width:{progress.ToString("F1",
            System.Globalization.CultureInfo.InvariantCulture)}%;";
}