@using System.Diagnostics
@inject ExperimentSaveService SaveService

<h3>Сумма элементов массива</h3>

<p>
    Линейный проход по массиву с накоплением суммы.
    Каждый элемент посещается ровно один раз.
</p>

<div class="alert alert-info">
    <strong>Сложность:</strong> O(n)<br />
    <strong>Память:</strong> O(1)
</div>

<hr />

<h3>Экспериментальный анализ</h3>

<div class="row">
    <div class="col-md-4 mb-3">
        <label>Максимальное n</label>
        <input type="number" min="1" class="form-control"
               @bind="maxN" disabled="@running" />
    </div>

    <div class="col-md-4 mb-3">
        <label>Шаг</label>
        <input type="number" min="1" class="form-control"
               @bind="step" disabled="@running" />
    </div>

    <div class="col-md-4 mb-3">
        <label>Запусков</label>
        <input class="form-control" value="@Runs" disabled />
    </div>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

<button class="btn btn-success"
        @onclick="Run"
        disabled="@running">
    @(running ? "Выполняется..." : "Запустить эксперимент")
</button>

@if (running)
{
    <div class="mt-4">
        <div class="d-flex justify-content-between">
            <span>n = @currentN, запуск @currentRun из @Runs</span>
            <strong>@progress.ToString("F1")%</strong>
        </div>
        <div class="progress mt-2" style="height:25px">
            <div class="progress-bar progress-bar-striped progress-bar-animated"
                 style="@ProgressStyle">
                @progress.ToString("F0")%
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(saved))
{
    <div class="alert alert-success mt-3">
        @saved
        <a href="/history" class="alert-link ms-2">История</a>
    </div>
}

@if (points.Count > 0)
{
    <div class="mt-5">
        <ComplexityChart Experimental="@points"
                         Approximation="@approximation.Points"
                         Title="Сумма элементов — временная сложность"
                         ApproximationName="Аппроксимация C·n"
                         XAxisTitle="Размер массива n"
                         YAxisTitle="Среднее время выполнения, мс"
                         Height="520" />

        <div class="alert alert-light border mt-4">
            <strong>Аппроксимация:</strong><br />
            T(n) ≈ @approximation.Coefficient.ToString("G6") · n<br />
            R² = @approximation.R2.ToString("F4")
        </div>

        <div class="alert alert-secondary">
            Один проход по массиву — сложность <strong>O(n)</strong>.
        </div>
    </div>
}


@code {
    private const int Runs = 5;
    private const int Repeats = 100;

    private int maxN = 2000;
    private int step = 50;

    private int currentN;
    private int currentRun;
    private double progress;
    private bool running;

    private string error = "";
    private string saved = "";

    private List<BenchmarkPoint> points = new();
    private ApproximationResult approximation = new();

    private async Task Run()
    {
        if (running) return;

        error = "";
        saved = "";

        if (maxN < 1 || step < 1)
        {
            error = "n и шаг должны быть больше нуля.";
            return;
        }

        running = true;
        points.Clear();

        var sizes = BuildSizes(maxN, step);
        int completed = 0;
        var rng = new Random();

        try
        {
            foreach (int n in sizes)
            {
                currentN = n;
                int[] v = new int[n];
                for (int i = 0; i < n; i++) v[i] = rng.Next(10000);

                double total = 0;

                for (int run = 1; run <= Runs; run++)
                {
                    currentRun = run;

                    var sw = Stopwatch.StartNew();
                    for (int j = 0; j < Repeats; j++) Algo(v);
                    sw.Stop();

                    total += sw.Elapsed.TotalMilliseconds / Repeats;

                    progress = (completed + (double)run / Runs) * 100 / sizes.Count;
                    StateHasChanged();
                    await Task.Yield();
                }

                points.Add(new BenchmarkPoint { N = n, TimeMs = total / Runs });
                completed++;
            }

            approximation = ApproximationService.Fit(points, ComplexityType.Linear);

            await SaveService.SaveAsync(
                "sum", "Сумма элементов", "O(n)",
                maxN, step, Runs, points, approximation);

            saved = "Эксперимент сохранён.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            progress = 100;
            running = false;
            currentN = 0;
            currentRun = 0;
        }
    }

    private static long Algo(int[] v)
    {
        long s = 0;
        for (int i = 0; i < v.Length; i++) s += v[i];
        return s;
    }

    private static List<int> BuildSizes(int max, int step)
    {
        var result = new List<int>();
        for (int n = 1; n <= max; n += step) result.Add(n);
        if (result.Count == 0 || result[^1] != max) result.Add(max);
        return result;
    }

    private string ProgressStyle =>
        $"width:{progress.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}%;";
}
