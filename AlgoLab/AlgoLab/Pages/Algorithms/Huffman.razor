@using System.Diagnostics
@inherits AlgorithmExperimentBase

<h3>Алгоритм Хаффмана</h3>
<p>Жадный алгоритм построения оптимального префиксного кода. На каждом шаге из очереди с приоритетом извлекаются два узла с наименьшими частотами и объединяются в новый узел с суммарной частотой. Итоговое дерево минимизирует средневзвешенную длину кода.</p>

<div class="alert alert-info">
    <strong>Лучший случай:</strong> O(n log n)<br />
    <strong>Средний случай:</strong> O(n log n)<br />
    <strong>Худший случай:</strong> O(n log n)<br />
    <strong>Память:</strong> O(n)
</div>

<hr />
<h3>Экспериментальный анализ</h3>

<div class="row">
    <div class="col-md-4 mb-3">
        <label>Максимальное n</label>
        <input type="number" min="1" class="form-control" @bind="MaxN" disabled="@Running" />
    </div>
    <div class="col-md-4 mb-3">
        <label>Шаг</label>
        <input type="number" min="1" class="form-control" @bind="Step" disabled="@Running" />
    </div>
    <div class="col-md-4 mb-3">
        <label>Запусков</label>
        <input class="form-control" value="@Runs" disabled />
    </div>
</div>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger">@Error</div>
}

<button class="btn btn-success" @onclick="OnRunClicked" disabled="@Running">
    @(Running ? "Выполняется..." : "Запустить эксперимент")
</button>

@if (Running)
{
    <div class="mt-4">
        <div class="d-flex justify-content-between">
            <span>n = @CurrentN, запуск @CurrentRun из @Runs</span>
            <strong>@Progress.ToString("F1")%</strong>
        </div>
        <div class="progress mt-2" style="height:25px">
            <div class="progress-bar progress-bar-striped progress-bar-animated" style="@ProgressStyle">
                @Progress.ToString("F0")%
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Saved))
{
    <div class="alert alert-success mt-3">
        @Saved <a href="/history" class="alert-link ms-2">История</a>
    </div>
}

@if (Points.Count > 0)
{
    <div class="mt-5">
        <ComplexityChart Experimental="@Points"
                         Approximation="@Approximation.Points"
                         Title="Алгоритм Хаффмана — временная сложность"
                         ApproximationName="Аппроксимация C·n·log(n)"
                         XAxisTitle="Количество символов n"
                         YAxisTitle="Среднее время выполнения, мс"
                         Height="520" />

        <div class="alert alert-light border mt-4">
            <strong>Аппроксимация:</strong><br />
            T(n) ≈ @Approximation.Coefficient.ToString("G6") · n·log(n)<br />
            R² = @Approximation.R2.ToString("F4")
        </div>

        <div class="alert alert-secondary">
            Для построения дерева выполняется ровно <strong>n − 1</strong> операций слияния. Каждая операция включает два извлечения минимума и одну вставку в приоритетную очередь, что даёт <strong>O(log n)</strong> на операцию. Итоговая сложность — <strong>O(n log n)</strong>.
        </div>
    </div>
}

<CachePromptDialog Show="ShowCachePrompt" Experiment="CachedExperiment"
                   OnUseCache="UseCachedResult" OnRecalculate="ForceRecalculate" />

@code {
    protected override string AlgorithmSlug => "huffman";
    protected override string AlgorithmName => "Алгоритм Хаффмана";
    protected override string AlgorithmComplexity => "O(n log n)";
    protected override ComplexityType ComplexityType => ComplexityType.Linearithmic;

    protected override int MaxN { get; set; } = 20000;
    protected override int Step { get; set; } = 1000;

    protected override async Task<List<BenchmarkPoint>> RunExperimentLogicAsync(
        int maxN, int step, int runs, Action<int, int, double> updateProgress)
    {
        var points = new List<BenchmarkPoint>();
        var sizes = BuildSizes(maxN, step);
        int completed = 0;
        var random = new Random();

        foreach (int n in sizes)
        {
            var original = new int[n];
            for (int i = 0; i < n; i++) original[i] = random.Next(1, 100_000);

            double total = 0;

            for (int run = 1; run <= runs; run++)
            {
                var sw = Stopwatch.StartNew();
                HuffmanCore(original);
                sw.Stop();

                total += sw.Elapsed.TotalMilliseconds;
                double progress = (completed + (double)run / runs) * 100 / sizes.Count;
                updateProgress(n, run, progress);
                await Task.Yield();
            }

            points.Add(new BenchmarkPoint { N = n, TimeMs = total / runs });
            completed++;
        }
        return points;
    }

    private static long HuffmanCore(int[] frequencies)
    {
        var pq = new PriorityQueue<HuffmanNode, long>(
            frequencies.Select(f => (new HuffmanNode { Frequency = f }, (long)f)));

        while (pq.Count > 1)
        {
            var a = pq.Dequeue();
            var b = pq.Dequeue();

            var parent = new HuffmanNode
            {
                Frequency = a.Frequency + b.Frequency,
                Left = a,
                Right = b
            };
            pq.Enqueue(parent, parent.Frequency);
        }

        var root = pq.Dequeue();
        return WeightedPathLength(root, 0);
    }

    private static long WeightedPathLength(HuffmanNode node, int depth)
    {
        if (node.Left == null && node.Right == null)
            return node.Frequency * (long)depth;
        return WeightedPathLength(node.Left!, depth + 1)
             + WeightedPathLength(node.Right!, depth + 1);
    }

    private class HuffmanNode
    {
        public long Frequency;
        public HuffmanNode? Left;
        public HuffmanNode? Right;
    }
}