@using System.Diagnostics
@inject ExperimentSaveService SaveService

<h3>Быстрая сортировка</h3>

<p>
    Quick Sort использует принцип «разделяй и властвуй»:
    выбирает опорный элемент, разбивает массив и рекурсивно
    сортирует получившиеся части.
</p>

<div class="alert alert-info">
    <strong>Лучший:</strong> O(n log n)<br />
    <strong>Средний:</strong> O(n log n)<br />
    <strong>Худший:</strong> O(n²)<br />
    <strong>Память:</strong> в среднем O(log n)
</div>

<hr />

<h3>Экспериментальный анализ</h3>

<div class="row">
    <div class="col-md-4 mb-3">
        <label>Максимальное n</label>
        <input type="number" min="1" class="form-control"
               @bind="maxN" disabled="@running" />
    </div>

    <div class="col-md-4 mb-3">
        <label>Шаг</label>
        <input type="number" min="1" class="form-control"
               @bind="step" disabled="@running" />
    </div>

    <div class="col-md-4 mb-3">
        <label>Запусков</label>
        <input class="form-control" value="@Runs" disabled />
    </div>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

<button class="btn btn-success"
        @onclick="Run"
        disabled="@running">
    @(running ? "Выполняется..." : "Запустить эксперимент")
</button>

@if (running)
{
    <div class="mt-4">
        <div class="d-flex justify-content-between">
            <span>n = @currentN, запуск @currentRun из @Runs</span>
            <strong>@progress.ToString("F1")%</strong>
        </div>

        <div class="progress mt-2" style="height:25px">
            <div class="progress-bar progress-bar-striped progress-bar-animated"
                 style="@ProgressStyle">
                @progress.ToString("F0")%
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(saved))
{
    <div class="alert alert-success mt-3">
        @saved
        <a href="/history" class="alert-link ms-2">История</a>
    </div>
}

@if (points.Count > 0)
{
    <div class="mt-5">

        <ComplexityChart Experimental="@points"
                         Approximation="@approximation.Points"
                         Title="Quick Sort — временная сложность"
                         ApproximationName="Аппроксимация C·n·log₂(n)"
                         XAxisTitle="Размер массива n"
                         YAxisTitle="Среднее время выполнения, мс"
                         Height="520" />

        <div class="alert alert-light border mt-4">
            <strong>Аппроксимация:</strong><br />
            T(n) ≈ @approximation.Coefficient.ToString("G6")
            · n · log₂(n)<br />
            R² = @approximation.R2.ToString("F4")
        </div>

        <div class="alert alert-secondary">
            Средняя временная сложность —
            <strong>O(n log n)</strong>.
            Худший случай — O(n²).
        </div>
    </div>
}

@code {
    private const int Runs = 5;

    private int maxN = 2000;
    private int step = 50;

    private int currentN;
    private int currentRun;
    private double progress;
    private bool running;

    private string error = "";
    private string saved = "";

    private List<BenchmarkPoint> points = new();
    private ApproximationResult approximation = new();

    private async Task Run()
    {
        if (running) return;

        error = "";
        saved = "";

        if (maxN < 1 || step < 1)
        {
            error = "n и шаг должны быть больше нуля.";
            return;
        }

        running = true;
        points.Clear();

        var sizes = BuildSizes(maxN, step);
        var random = new Random();
        int completed = 0;

        try
        {
            foreach (int n in sizes)
            {
                currentN = n;

                var original = new int[n];

                for (int i = 0; i < n; i++)
                    original[i] = random.Next(100_000);

                double total = 0;

                for (int run = 1; run <= Runs; run++)
                {
                    currentRun = run;

                    var data = (int[])original.Clone();

                    var sw = Stopwatch.StartNew();
                    Sort(data, 0, data.Length - 1);
                    sw.Stop();

                    total += sw.Elapsed.TotalMilliseconds;

                    progress =
                        (completed + (double)run / Runs)
                        * 100 / sizes.Count;

                    StateHasChanged();
                    await Task.Yield();
                }

                points.Add(new BenchmarkPoint
                {
                    N = n,
                    TimeMs = total / Runs
                });

                completed++;
            }

            approximation = ApproximationService.Fit(
                points,
                ComplexityType.Linearithmic);

            await SaveService.SaveAsync(
                "quick",
                "Быстрая сортировка",
                "O(n log n)",
                maxN,
                step,
                Runs,
                points,
                approximation);

            saved = "Эксперимент сохранён.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            progress = 100;
            running = false;
            currentN = 0;
            currentRun = 0;
        }
    }

    private static void Sort(int[] data, int low, int high)
    {
        if (low >= high) return;

        int p = Partition(data, low, high);

        Sort(data, low, p - 1);
        Sort(data, p + 1, high);
    }

    private static int Partition(int[] data, int low, int high)
    {
        int pivot = data[high];
        int i = low - 1;

        for (int j = low; j < high; j++)
        {
            if (data[j] <= pivot)
            {
                i++;

                (data[i], data[j]) =
                    (data[j], data[i]);
            }
        }

        (data[i + 1], data[high]) =
            (data[high], data[i + 1]);

        return i + 1;
    }

    private static List<int> BuildSizes(int max, int step)
    {
        var result = new List<int>();

        for (int n = 1; n <= max; n += step)
            result.Add(n);

        if (result.Count == 0 || result[^1] != max)
            result.Add(max);

        return result;
    }

    private string ProgressStyle =>
        $"width:{progress.ToString("F1",
            System.Globalization.CultureInfo.InvariantCulture)}%;";
}