@using System.Diagnostics
@inherits AlgorithmExperimentBase

<h3>Наивное вычисление полинома</h3>
<p>Прямое вычисление P(x) = Σ vₖ · xᵏ⁻¹ при x = 1.5. Каждый член xᵏ вычисляется отдельным циклом умножений.</p>

<div class="alert alert-info">
    <strong>Сложность:</strong> O(n²) — за счёт вложенного цикла<br />
    <strong>Память:</strong> O(1)
</div>

<hr />
<h3>Экспериментальный анализ</h3>

<div class="row">
    <div class="col-md-4 mb-3">
        <label>Максимальное n</label>
        <input type="number" min="1" class="form-control" @bind="MaxN" disabled="@Running" />
    </div>
    <div class="col-md-4 mb-3">
        <label>Шаг</label>
        <input type="number" min="1" class="form-control" @bind="Step" disabled="@Running" />
    </div>
    <div class="col-md-4 mb-3">
        <label>Запусков</label>
        <input class="form-control" value="@Runs" disabled />
    </div>
</div>

@if (MaxN >= 3000)
{
    <div class="alert alert-warning">
        Наивный полином имеет сложность O(n²). Большое n может потребовать значительного времени.
    </div>
}

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger">@Error</div>
}

<button class="btn btn-success" @onclick="OnRunClicked" disabled="@Running">
    @(Running ? "Выполняется..." : "Запустить эксперимент")
</button>

@if (Running)
{
    <div class="mt-4">
        <div class="d-flex justify-content-between">
            <span>n = @CurrentN, запуск @CurrentRun из @Runs</span>
            <strong>@Progress.ToString("F1")%</strong>
        </div>
        <div class="progress mt-2" style="height:25px">
            <div class="progress-bar progress-bar-striped progress-bar-animated" style="@ProgressStyle">
                @Progress.ToString("F0")%
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Saved))
{
    <div class="alert alert-success mt-3">
        @Saved <a href="/history" class="alert-link ms-2">История</a>
    </div>
}

@if (Points.Count > 0)
{
    <div class="mt-5">
        <ComplexityChart Experimental="@Points"
                         Approximation="@Approximation.Points"
                         Title="Наивный полином — временная сложность"
                         ApproximationName="Аппроксимация C·n²"
                         XAxisTitle="Степень полинома n"
                         YAxisTitle="Среднее время выполнения, мс"
                         Height="520" />

        <div class="alert alert-light border mt-4">
            <strong>Аппроксимация:</strong><br />
            T(n) ≈ @Approximation.Coefficient.ToString("G6") · n²<br />
            R² = @Approximation.R2.ToString("F4")
        </div>

        <div class="alert alert-secondary">
            Вложенный цикл для вычисления xᵏ даёт <strong>O(n²)</strong>
            — метод Горнера решает ту же задачу за O(n).
        </div>
    </div>
}

<CachePromptDialog Show="ShowCachePrompt" Experiment="CachedExperiment"
                   OnUseCache="UseCachedResult" OnRecalculate="ForceRecalculate" />

@code {
    private const int Repeats = 10;

    protected override string AlgorithmSlug => "poly-naive";
    protected override string AlgorithmName => "Наивный полином";
    protected override string AlgorithmComplexity => "O(n²)";
    protected override ComplexityType ComplexityType => ComplexityType.Quadratic;

    protected override async Task<List<BenchmarkPoint>> RunExperimentLogicAsync(
        int maxN, int step, int runs, Action<int, int, double> updateProgress)
    {
        var points = new List<BenchmarkPoint>();
        var sizes = BuildSizes(maxN, step);
        int completed = 0;
        var rng = new Random();

        foreach (int n in sizes)
        {
            int[] v = new int[n];
            for (int i = 0; i < n; i++) v[i] = rng.Next(10000);

            double total = 0;

            for (int run = 1; run <= runs; run++)
            {
                var sw = Stopwatch.StartNew();
                for (int j = 0; j < Repeats; j++) Algo(v);
                sw.Stop();

                total += sw.Elapsed.TotalMilliseconds / Repeats;
                double progress = (completed + (double)run / runs) * 100 / sizes.Count;
                updateProgress(n, run, progress);
                await Task.Yield();
            }

            points.Add(new BenchmarkPoint { N = n, TimeMs = total / runs });
            completed++;
        }
        return points;
    }

    private static double Algo(int[] v)
    {
        double x = 1.5, result = 0;
        for (int k = 0; k < v.Length; k++)
        {
            double xk = 1;
            for (int j = 0; j < k; j++) xk *= x;
            result += v[k] * xk;
        }
        return result;
    }
}