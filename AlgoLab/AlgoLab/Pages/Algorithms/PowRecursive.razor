@using System.Diagnostics
@inject ExperimentSaveService SaveService

<h3>Рекурсивное возведение в степень</h3>

<p>
    Рекурсивный алгоритм, основанный на формуле
    <em>x<sup>n</sup> = x · x<sup>n−1</sup></em>.
    На каждом шаге степень уменьшается на единицу,
    пока не достигнет нуля.
</p>

<div class="alert alert-info">
    <strong>Сложность:</strong> O(n)<br />
    <strong>Количество умножений / рекурсивных вызовов:</strong> n<br />
    <strong>Глубина рекурсии:</strong> n
</div>

<hr />

<h3>Экспериментальный анализ</h3>

<div class="row">
    <div class="col-md-6 mb-3">
        <label>Максимальное n</label>
        <input type="number" min="1" class="form-control"
               @bind="maxN" disabled="@running" />
    </div>

    <div class="col-md-6 mb-3">
        <label>Шаг</label>
        <input type="number" min="1" class="form-control"
               @bind="step" disabled="@running" />
    </div>
</div>

@if (maxN > 2000)
{
    <div class="alert alert-warning">
        Рекурсивный алгоритм имеет глубину рекурсии n.
        Большое n может привести к переполнению стека.
    </div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

<button class="btn btn-success"
        @onclick="Run"
        disabled="@running">
    @(running ? "Выполняется..." : "Запустить эксперимент")
</button>

@if (running)
{
    <div class="mt-4">
        <div class="d-flex justify-content-between">
            <span>n = @currentN</span>
            <strong>@progress.ToString("F1")%</strong>
        </div>

        <div class="progress mt-2" style="height:25px">
            <div class="progress-bar progress-bar-striped progress-bar-animated"
                 style="@ProgressStyle">
                @progress.ToString("F0")%
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(saved))
{
    <div class="alert alert-success mt-3">
        @saved
        <a href="/history" class="alert-link ms-2">История</a>
    </div>
}

@if (points.Count > 0)
{
    <div class="mt-5">

        <ComplexityChart Experimental="@points"
                         Approximation="@approximation.Points"
                         Title="Рекурсивное возведение в степень — число шагов"
                         ApproximationName="Аппроксимация C·n"
                         XAxisTitle="Показатель степени n"
                         YAxisTitle="Количество шагов (вызовов)"
                         Height="520" />

        <div class="alert alert-light border mt-4">
            <strong>Аппроксимация:</strong><br />
            T(n) ≈ @approximation.Coefficient.ToString("G6") · n<br />
            R² = @approximation.R2.ToString("F4")
        </div>

        <div class="alert alert-secondary">
            Рекурсивный алгоритм выполняет ровно n умножений
            и n рекурсивных вызовов. Следовательно, сложность
            составляет <strong>O(n)</strong>, а глубина рекурсии — <strong>O(n)</strong>.
        </div>
    </div>
}

@code {
    private int maxN = 1000;
    private int step = 50;

    private int currentN;
    private double progress;
    private bool running;

    private string error = "";
    private string saved = "";

    private List<BenchmarkPoint> points = new();
    private ApproximationResult approximation = new();

    private const long BaseX = 2;
    private const long Mod = 1_000_000_007;

    private async Task Run()
    {
        if (running) return;

        error = "";
        saved = "";

        if (maxN < 1 || step < 1)
        {
            error = "n и шаг должны быть больше нуля.";
            return;
        }

        running = true;
        points.Clear();

        var sizes = BuildSizes(maxN, step);
        int completed = 0;

        try
        {
            foreach (int n in sizes)
            {
                currentN = n;

                long steps = 0;
                Power(BaseX, n, ref steps);

                points.Add(new BenchmarkPoint
                {
                    N = n,
                    TimeMs = steps
                });

                completed++;

                progress = (double)completed * 100 / sizes.Count;
                StateHasChanged();
                await Task.Yield();
            }

            approximation = ApproximationService.Fit(
                points,
                ComplexityType.Linear);

            await SaveService.SaveAsync(
                "power-recursive",
                "Рекурсивное возведение в степень",
                "O(n)",
                maxN,
                step,
                1,
                points,
                approximation);

            saved = "Эксперимент сохранён.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            progress = 100;
            running = false;
            currentN = 0;
        }
    }

    private static long Power(long x, int n, ref long steps)
    {
        if (n == 0)
            return 1;

        steps++; // один рекурсивный вызов = одно умножение
        long inner = Power(x, n - 1, ref steps);
        return (x * inner) % Mod;
    }

    private static List<int> BuildSizes(int max, int step)
    {
        var result = new List<int>();

        for (int n = 1; n <= max; n += step)
            result.Add(n);

        if (result.Count == 0 || result[^1] != max)
            result.Add(max);

        return result;
    }

    private string ProgressStyle =>
        $"width:{progress.ToString("F1",
            System.Globalization.CultureInfo.InvariantCulture)}%;";
}