@using System.Diagnostics
@inherits AlgorithmExperimentBase

<h3>Рекурсивное возведение в степень</h3>
<p>Рекурсивный алгоритм, основанный на формуле <em>x<sup>n</sup> = x · x<sup>n−1</sup></em>. На каждом шаге степень уменьшается на единицу, пока не достигнет нуля.</p>

<div class="alert alert-info">
    <strong>Сложность:</strong> O(n)<br />
    <strong>Количество умножений / рекурсивных вызовов:</strong> n<br />
    <strong>Глубина рекурсии:</strong> n
</div>

<hr />
<h3>Экспериментальный анализ</h3>

<div class="row">
    <div class="col-md-6 mb-3">
        <label>Максимальное n</label>
        <input type="number" min="1" class="form-control" @bind="MaxN" disabled="@Running" />
    </div>
    <div class="col-md-6 mb-3">
        <label>Шаг</label>
        <input type="number" min="1" class="form-control" @bind="Step" disabled="@Running" />
    </div>
</div>

@if (MaxN > 2000)
{
    <div class="alert alert-warning">
        Рекурсивный алгоритм имеет глубину рекурсии n. Большое n может привести к переполнению стека.
    </div>
}

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger">@Error</div>
}

<button class="btn btn-success" @onclick="OnRunClicked" disabled="@Running">
    @(Running ? "Выполняется..." : "Запустить эксперимент")
</button>

@if (Running)
{
    <div class="mt-4">
        <div class="d-flex justify-content-between">
            <span>n = @CurrentN</span>
            <strong>@Progress.ToString("F1")%</strong>
        </div>
        <div class="progress mt-2" style="height:25px">
            <div class="progress-bar progress-bar-striped progress-bar-animated" style="@ProgressStyle">
                @Progress.ToString("F0")%
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Saved))
{
    <div class="alert alert-success mt-3">
        @Saved <a href="/history" class="alert-link ms-2">История</a>
    </div>
}

@if (Points.Count > 0)
{
    <div class="mt-5">
        <ComplexityChart Experimental="@Points"
                         Approximation="@Approximation.Points"
                         Title="Рекурсивное возведение в степень — число шагов"
                         ApproximationName="Аппроксимация C·n"
                         XAxisTitle="Показатель степени n"
                         YAxisTitle="Количество шагов (вызовов)"
                         Height="520" />

        <div class="alert alert-light border mt-4">
            <strong>Аппроксимация:</strong><br />
            T(n) ≈ @Approximation.Coefficient.ToString("G6") · n<br />
            R² = @Approximation.R2.ToString("F4")
        </div>

        <div class="alert alert-secondary">
            Рекурсивный алгоритм выполняет ровно n умножений
            и n рекурсивных вызовов. Следовательно, сложность
            составляет <strong>O(n)</strong>, а глубина рекурсии — <strong>O(n)</strong>.
        </div>
    </div>
}

<CachePromptDialog Show="ShowCachePrompt" Experiment="CachedExperiment"
                   OnUseCache="UseCachedResult" OnRecalculate="ForceRecalculate" />

@code {
    protected override string AlgorithmSlug => "power-recursive";
    protected override string AlgorithmName => "Рекурсивное возведение в степень";
    protected override string AlgorithmComplexity => "O(n)";
    protected override ComplexityType ComplexityType => ComplexityType.Linear;

    protected override int MaxN { get; set; } = 1000;
    protected override int Step { get; set; } = 50;
    protected override int Runs { get => 1; set { } }

    protected override async Task<List<BenchmarkPoint>> RunExperimentLogicAsync(
        int maxN, int step, int runs, Action<int, int, double> updateProgress)
    {
        var points = new List<BenchmarkPoint>();
        var sizes = BuildSizes(maxN, step);
        int completed = 0;

        foreach (int n in sizes)
        {
            long steps = 0;
            CountSteps(n, ref steps);

            points.Add(new BenchmarkPoint { N = n, TimeMs = steps });
            completed++;

            double progress = (double)completed * 100 / sizes.Count;
            updateProgress(n, 1, progress);
            await Task.Yield();
        }
        return points;
    }

    private static void CountSteps(int n, ref long steps)
    {
        if (n == 0) return;
        steps++;
        CountSteps(n - 1, ref steps);
    }
}