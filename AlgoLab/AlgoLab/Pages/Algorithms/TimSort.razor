@using System.Diagnostics
@inherits AlgorithmExperimentBase

<h3>TimSort</h3>
<p>Учебная реализация гибридной сортировки: небольшие серии сортируются вставками, после чего объединяются слиянием.</p>

<div class="alert alert-info">
    <strong>Средний:</strong> O(n log n)<br />
    <strong>Худший:</strong> O(n log n)<br />
    <strong>Память:</strong> O(n)
</div>

<hr />
<h3>Экспериментальный анализ</h3>

<div class="row">
    <div class="col-md-4 mb-3">
        <label>Максимальное n</label>
        <input type="number" min="1" class="form-control" @bind="MaxN" disabled="@Running" />
    </div>
    <div class="col-md-4 mb-3">
        <label>Шаг</label>
        <input type="number" min="1" class="form-control" @bind="Step" disabled="@Running" />
    </div>
    <div class="col-md-4 mb-3">
        <label>Запусков</label>
        <input class="form-control" value="@Runs" disabled />
    </div>
</div>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger">@Error</div>
}

<button class="btn btn-success" @onclick="OnRunClicked" disabled="@Running">
    @(Running ? "Выполняется..." : "Запустить эксперимент")
</button>

@if (Running)
{
    <div class="mt-4">
        <div class="d-flex justify-content-between">
            <span>n = @CurrentN, запуск @CurrentRun из @Runs</span>
            <strong>@Progress.ToString("F1")%</strong>
        </div>
        <div class="progress mt-2" style="height:25px">
            <div class="progress-bar progress-bar-striped progress-bar-animated" style="@ProgressStyle">
                @Progress.ToString("F0")%
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Saved))
{
    <div class="alert alert-success mt-3">
        @Saved <a href="/history" class="alert-link ms-2">История</a>
    </div>
}

@if (Points.Count > 0)
{
    <div class="mt-5">
        <ComplexityChart Experimental="@Points"
                         Approximation="@Approximation.Points"
                         Title="TimSort — временная сложность"
                         ApproximationName="Аппроксимация C·n·log₂(n)"
                         XAxisTitle="Размер массива n"
                         YAxisTitle="Среднее время выполнения, мс"
                         Height="520" />

        <div class="alert alert-light border mt-4">
            T(n) ≈ @Approximation.Coefficient.ToString("G6") · n · log₂(n)<br />
            R² = @Approximation.R2.ToString("F4")
        </div>
    </div>
}

<CachePromptDialog Show="ShowCachePrompt" Experiment="CachedExperiment"
                   OnUseCache="UseCachedResult" OnRecalculate="ForceRecalculate" />

@code {
    private const int RunSize = 32;

    protected override string AlgorithmSlug => "timsort";
    protected override string AlgorithmName => "TimSort";
    protected override string AlgorithmComplexity => "O(n log n)";
    protected override ComplexityType ComplexityType => ComplexityType.Linearithmic;

    protected override async Task<List<BenchmarkPoint>> RunExperimentLogicAsync(
        int maxN, int step, int runs, Action<int, int, double> updateProgress)
    {
        var points = new List<BenchmarkPoint>();
        var sizes = BuildSizes(maxN, step);
        var random = new Random();
        int completed = 0;

        foreach (int n in sizes)
        {
            var original = new int[n];
            for (int i = 0; i < n; i++) original[i] = random.Next(100_000);

            double total = 0;

            for (int run = 1; run <= runs; run++)
            {
                var data = (int[])original.Clone();
                var sw = Stopwatch.StartNew();
                Sort(data);
                sw.Stop();

                total += sw.Elapsed.TotalMilliseconds;
                double progress = (completed + (double)run / runs) * 100 / sizes.Count;
                updateProgress(n, run, progress);
                await Task.Yield();
            }

            points.Add(new BenchmarkPoint { N = n, TimeMs = total / runs });
            completed++;
        }
        return points;
    }

    private static void Sort(int[] data)
    {
        int n = data.Length;
        for (int start = 0; start < n; start += RunSize)
            InsertionSort(data, start, Math.Min(start + RunSize - 1, n - 1));

        for (int size = RunSize; size < n; size *= 2)
        {
            for (int left = 0; left < n; left += 2 * size)
            {
                int middle = Math.Min(left + size - 1, n - 1);
                int right = Math.Min(left + 2 * size - 1, n - 1);
                if (middle < right) Merge(data, left, middle, right);
            }
        }
    }

    private static void InsertionSort(int[] data, int left, int right)
    {
        for (int i = left + 1; i <= right; i++)
        {
            int value = data[i];
            int j = i - 1;
            while (j >= left && data[j] > value)
            {
                data[j + 1] = data[j];
                j--;
            }
            data[j + 1] = value;
        }
    }

    private static void Merge(int[] data, int left, int middle, int right)
    {
        int[] a = data[left..(middle + 1)];
        int[] b = data[(middle + 1)..(right + 1)];
        int i = 0, j = 0, k = left;
        while (i < a.Length && j < b.Length)
            data[k++] = a[i] <= b[j] ? a[i++] : b[j++];
        while (i < a.Length) data[k++] = a[i++];
        while (j < b.Length) data[k++] = b[j++];
    }
}