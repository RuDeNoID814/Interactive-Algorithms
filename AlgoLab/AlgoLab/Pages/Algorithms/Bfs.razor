@using System.Diagnostics
@inherits AlgorithmExperimentBase

<h3>Обход в ширину (BFS)</h3>

<p>Алгоритм обходит граф уровень за уровнем, используя очередь. Начинает с корневой вершины, посещает всех соседей, затем соседей соседей и т.д.</p>

<div class="alert alert-info">
    <strong>Сложность:</strong> O(V + E), где V — вершины, E — рёбра<br />
    <strong>Память:</strong> O(V)<br />
    <strong>Структура данных:</strong> Очередь (Queue)
</div>

<hr />
<h5>Экспериментальный анализ</h5>

<p class="text-muted small">
    Случайный разреженный граф: n вершин, ~2n рёбер. Замеряется время BFS от вершины 0.
</p>

<div class="row">
    <div class="col-md-4 mb-3">
        <label>Максимальное n</label>
        <input type="number" min="100" max="100000" step="100"
               class="form-control" @bind="MaxN" disabled="@Running" />
    </div>
    <div class="col-md-4 mb-3">
        <label>Шаг</label>
        <input type="number" min="50" max="2000" step="50"
               class="form-control" @bind="Step" disabled="@Running" />
    </div>
    <div class="col-md-4 mb-3">
        <label>Запусков</label>
        <input class="form-control" value="@Runs" disabled />
    </div>
</div>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger">@Error</div>
}

<button class="btn btn-success" @onclick="OnRunClicked" disabled="@Running">
    @(Running ? "Выполняется..." : "Запустить эксперимент")
</button>

@if (Running)
{
    <div class="mt-4">
        <div class="d-flex justify-content-between">
            <span>n = @CurrentN</span>
            <strong>@Progress.ToString("F1")%</strong>
        </div>
        <div class="progress mt-2" style="height:25px">
            <div class="progress-bar progress-bar-striped progress-bar-animated" style="@ProgressStyle">
                @Progress.ToString("F0")%
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Saved))
{
    <div class="alert alert-success mt-3">
        @Saved <a href="/history" class="alert-link ms-2">История</a>
    </div>
}

@if (Points.Count > 0)
{
    <div class="mt-5">
        <ComplexityChart Experimental="@Points"
                         Approximation="@Approximation.Points"
                         Title="BFS — временная сложность"
                         ApproximationName="Аппроксимация C·n"
                         XAxisTitle="Количество вершин n"
                         YAxisTitle="Среднее время выполнения, мс"
                         Height="520" />

        <div class="alert alert-light border mt-4">
            <strong>Аппроксимация:</strong><br />
            T(n) ≈ @Approximation.Coefficient.ToString("G6") · n<br />
            R² = @Approximation.R2.ToString("F4")
        </div>

        <div class="alert alert-secondary">
            При разреженном графе (~2n рёбер) T(n) растёт линейно,
            что подтверждает сложность <strong>O(V+E)</strong>.
        </div>
    </div>
}

<CachePromptDialog Show="ShowCachePrompt" Experiment="CachedExperiment"
                   OnUseCache="UseCachedResult" OnRecalculate="ForceRecalculate" />

@code {
    protected override string AlgorithmSlug => "bfs";
    protected override string AlgorithmName => "Обход в ширину (BFS)";
    protected override string AlgorithmComplexity => "O(V+E)";
    protected override ComplexityType ComplexityType => ComplexityType.Linear;

    protected override int MaxN { get; set; } = 5000;
    protected override int Step { get; set; } = 200;

    // ── Бенчмарк ─────────────────────────────────────────────
    protected override async Task<List<BenchmarkPoint>> RunExperimentLogicAsync(
        int maxN, int step, int runs, Action<int, int, double> updateProgress)
    {
        var points = new List<BenchmarkPoint>();
        var rng = new Random();

        // BFS строит размеры, начиная с step, а не с 1
        var sizes = new List<int>();
        for (int n = step; n <= maxN; n += step) sizes.Add(n);
        if (sizes.Count == 0 || sizes[^1] != maxN) sizes.Add(maxN);

        int completed = 0;

        foreach (int n in sizes)
        {
            var adj = BuildGraph(n, rng);

            double total = 0;
            for (int r = 1; r <= runs; r++)
            {
                var sw = Stopwatch.StartNew();
                BfsAlgo(adj, n);
                sw.Stop();
                total += sw.Elapsed.TotalMilliseconds;

                double progress = (completed + (double)r / runs) * 100 / sizes.Count;
                updateProgress(n, r, progress);
                await Task.Yield();
            }

            points.Add(new BenchmarkPoint { N = n, TimeMs = total / runs });
            completed++;
        }
        return points;
    }

    static List<List<int>> BuildGraph(int n, Random rng)
    {
        var adj = new List<List<int>>(n);
        for (int i = 0; i < n; i++) adj.Add(new List<int>());

        for (int i = 1; i < n; i++)
        {
            adj[i - 1].Add(i);
            adj[i].Add(i - 1);
        }
        for (int e = 0; e < n; e++)
        {
            int u = rng.Next(n), v = rng.Next(n);
            if (u != v) { adj[u].Add(v); adj[v].Add(u); }
        }
        return adj;
    }

    static void BfsAlgo(List<List<int>> adj, int n)
    {
        var visited = new bool[n];
        var q = new Queue<int>();
        visited[0] = true;
        q.Enqueue(0);
        while (q.Count > 0)
        {
            int v = q.Dequeue();
            foreach (int u in adj[v])
                if (!visited[u]) { visited[u] = true; q.Enqueue(u); }
        }
    }
}
