@using System.Diagnostics
@inject ExperimentSaveService SaveService

<h3>Обход в ширину (BFS)</h3>

<p>
    Алгоритм обходит граф уровень за уровнем, используя очередь.
    Начинает с корневой вершины, посещает всех соседей, затем соседей соседей и т.д.
</p>

<div class="alert alert-info">
    <strong>Сложность:</strong> O(V + E), где V — вершины, E — рёбра<br />
    <strong>Память:</strong> O(V)<br />
    <strong>Структура данных:</strong> Очередь (Queue)
</div>

<hr />

<h5>Визуализация</h5>

<p class="text-muted small">
    Дерево обходится уровень за уровнем. Можно добавлять вершины вручную.
</p>

<!-- Добавление вершины -->
<div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
    <label class="mb-0">Добавить дочернюю вершину к узлу:</label>
    <select class="form-select form-select-sm" style="width:80px"
            @bind="addParent" disabled="@vizRunning">
        @for (int i = 0; i < nodeParent.Count; i++)
        {
            <option value="@i">@i</option>
        }
    </select>
    <button class="btn btn-sm btn-outline-primary"
            @onclick="AddNode"
            disabled="@vizRunning">
        + Добавить
    </button>
    <button class="btn btn-sm btn-outline-danger"
            @onclick="ResetTree"
            disabled="@vizRunning">
        Сбросить дерево
    </button>
</div>

<!-- SVG граф -->
<div class="mb-3" style="overflow-x:auto">
    @((MarkupString)BuildSvg())
</div>

<!-- Легенда -->
<div class="d-flex gap-3 mb-3 flex-wrap">
    <span><span style="color:#6b7280">■</span> Не посещена</span>
    <span><span style="color:#f59e0b">■</span> В очереди</span>
    <span><span style="color:#3b82f6">■</span> Текущая</span>
    <span><span style="color:#10b981">■</span> Посещена</span>
</div>

<!-- Очередь и порядок -->
<div class="row mb-3">
    <div class="col-md-6">
        <div class="card card-body p-2">
            <small class="text-muted">Очередь</small>
            <div>
                @if (vizDone)
                {
                    <span class="text-success">пусто — обход завершён</span>
                }
                else if (vizQueue.Count == 0)
                {
                    <span class="text-muted">[ ]</span>
                }
                else
                {
                    <span>[ @string.Join(", ", vizQueue) ]</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card card-body p-2">
            <small class="text-muted">Порядок посещения</small>
            <div>
                @if (vizOrder.Count == 0)
                {
                    <span class="text-muted">—</span>
                }
                else
                {
                    <span>@string.Join(" → ", vizOrder)</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Кнопки BFS -->
<div class="d-flex gap-2 mb-5">
    <button class="btn btn-primary"
            @onclick="VizStep"
            disabled="@(vizDone || vizRunning)">
        Шаг
    </button>
    <button class="btn btn-success"
            @onclick="VizAutoRun"
            disabled="@(vizDone || vizRunning)">
        @(vizRunning ? "Идёт..." : "Авто")
    </button>
    <button class="btn btn-secondary"
            @onclick="VizReset"
            disabled="@vizRunning">
        Сбросить обход
    </button>
</div>

<hr />

<h5>Экспериментальный анализ</h5>

<p class="text-muted small">
    Случайный разреженный граф: n вершин, ~2n рёбер. Замеряется время BFS от вершины 0.
</p>

<div class="row">
    <div class="col-md-4 mb-3">
        <label>Максимальное n</label>
        <input type="number" min="100" max="100000" step="100"
               class="form-control"
               @bind="maxN" disabled="@benchRunning" />
    </div>
    <div class="col-md-4 mb-3">
        <label>Шаг</label>
        <input type="number" min="50" max="2000" step="50"
               class="form-control"
               @bind="benchStep" disabled="@benchRunning" />
    </div>
    <div class="col-md-4 mb-3">
        <label>Запусков</label>
        <input class="form-control" value="@Runs" disabled />
    </div>
</div>

@if (!string.IsNullOrEmpty(benchError))
{
    <div class="alert alert-danger">@benchError</div>
}

<button class="btn btn-success"
        @onclick="RunBenchmark"
        disabled="@benchRunning">
    @(benchRunning ? "Выполняется..." : "Запустить эксперимент")
</button>

@if (benchRunning)
{
    <div class="mt-4">
        <div class="d-flex justify-content-between">
            <span>n = @currentBenchN</span>
            <strong>@progress.ToString("F1")%</strong>
        </div>
        <div class="progress mt-2" style="height:25px">
            <div class="progress-bar progress-bar-striped progress-bar-animated"
                 style="@ProgressStyle">
                @progress.ToString("F0")%
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(saved))
{
    <div class="alert alert-success mt-3">
        @saved
        <a href="/history" class="alert-link ms-2">История</a>
    </div>
}

@if (benchPoints.Count > 0)
{
    <div class="mt-5">
        <ComplexityChart Experimental="@benchPoints"
                         Approximation="@approximation.Points"
                         Title="BFS — временная сложность"
                         ApproximationName="Аппроксимация C·n"
                         XAxisTitle="Количество вершин n"
                         YAxisTitle="Среднее время выполнения, мс"
                         Height="520" />

        <div class="alert alert-light border mt-4">
            <strong>Аппроксимация:</strong><br />
            T(n) ≈ @approximation.Coefficient.ToString("G6") · n<br />
            R² = @approximation.R2.ToString("F4")
        </div>

        <div class="alert alert-secondary">
            При разреженном графе (~2n рёбер) T(n) растёт линейно,
            что подтверждает сложность <strong>O(V+E)</strong>.
        </div>
    </div>
}


@code {

    private const int Runs = 5;

    // ── Дерево (динамическое) ────────────────────────────────

    // nodeParent[i] = родитель узла i (-1 для корня)
    List<int> nodeParent = new() { -1, 0, 0, 1, 1, 1, 3, 5, 5 };
    int addParent = 0;

    List<int> GetChildren(int node) =>
        nodeParent
            .Select((p, i) => (p, i))
            .Where(x => x.p == node)
            .Select(x => x.i)
            .ToList();

    void AddNode()
    {
        nodeParent.Add(addParent);
        ComputeLayout();
        VizReset();
    }

    void ResetTree()
    {
        nodeParent = new() { -1, 0, 0, 1, 1, 1, 3, 5, 5 };
        addParent = 0;
        ComputeLayout();
        VizReset();
    }


    // ── Автоматический layout дерева ─────────────────────────

    Dictionary<int, (double X, double Y)> nodePos = new();
    double svgWidth = 700;
    double svgHeight = 380;

    protected override void OnInitialized()
    {
        ComputeLayout();
        VizReset();
    }

    void ComputeLayout()
    {
        nodePos.Clear();

        int n = nodeParent.Count;
        double xGap = 60;
        double yGap = 90;

        // вычисляем размер поддерева для каждого узла
        var size = new int[n];
        for (int i = 0; i < n; i++) size[i] = 1;

        // идём снизу вверх (постпорядок)
        for (int i = n - 1; i >= 1; i--)
            size[nodeParent[i]] += size[i];

        // Назначаем X через обход в ширину, распределяя листья равномерно
        var xOffset = new double[n];
        double curX = 40;

        // DFS для назначения позиций листьев
        void Dfs(int node, int depth)
        {
            var children = GetChildren(node);
            if (children.Count == 0)
            {
                xOffset[node] = curX;
                curX += xGap;
                return;
            }
            foreach (int c in children) Dfs(c, depth + 1);
            // центр над детьми
            xOffset[node] = (xOffset[children[0]] + xOffset[children[^1]]) / 2;
        }
        Dfs(0, 0);

        // глубины через BFS
        var depth = new int[n];
        var queue = new Queue<int>();
        queue.Enqueue(0);
        while (queue.Count > 0)
        {
            int v = queue.Dequeue();
            foreach (int c in GetChildren(v))
            {
                depth[c] = depth[v] + 1;
                queue.Enqueue(c);
            }
        }

        int maxDepth = depth.Max();
        svgHeight = 40 + maxDepth * yGap + 80;
        svgWidth = Math.Max(700, curX + 20);

        for (int i = 0; i < n; i++)
            nodePos[i] = (xOffset[i], 40 + depth[i] * yGap);
    }


    // ── Визуализация BFS ─────────────────────────────────────

    List<int> vizQueue = new();
    HashSet<int> vizInQueue = new();
    HashSet<int> vizVisited = new();
    List<int> vizOrder = new();
    int? vizCurrent = null;
    bool vizDone = false;
    bool vizRunning = false;

    void VizReset()
    {
        vizQueue = new List<int> { 0 };
        vizInQueue = new HashSet<int> { 0 };
        vizVisited = new HashSet<int>();
        vizOrder = new List<int>();
        vizCurrent = null;
        vizDone = false;
    }

    async Task VizStep()
    {
        if (vizQueue.Count == 0) { vizDone = true; return; }

        int node = vizQueue[0];
        vizQueue.RemoveAt(0);
        vizInQueue.Remove(node);
        vizCurrent = node;
        vizVisited.Add(node);
        vizOrder.Add(node);

        foreach (int nb in GetChildren(node))
        {
            if (!vizVisited.Contains(nb) && !vizInQueue.Contains(nb))
            {
                vizQueue.Add(nb);
                vizInQueue.Add(nb);
            }
        }
        // BFS по рёбрам родитель → ребёнок только вниз,
        // но дерево неориентированное — учитываем и ребро вверх
        int par = node < nodeParent.Count ? nodeParent[node] : -1;
        if (par >= 0 && !vizVisited.Contains(par) && !vizInQueue.Contains(par))
        {
            vizQueue.Add(par);
            vizInQueue.Add(par);
        }

        if (vizQueue.Count == 0) { vizDone = true; vizCurrent = null; }
        StateHasChanged();
    }

    async Task VizAutoRun()
    {
        vizRunning = true;
        while (vizQueue.Count > 0 && !vizDone)
        {
            await VizStep();
            await Task.Delay(700);
        }
        vizCurrent = null;
        vizDone = true;
        vizRunning = false;
        StateHasChanged();
    }

    string NodeColor(int n)
    {
        if (vizCurrent == n) return "#3b82f6";
        if (vizVisited.Contains(n)) return "#10b981";
        if (vizInQueue.Contains(n)) return "#f59e0b";
        return "#6b7280";
    }

    string BuildSvg()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox=\"0 0 {svgWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)} {svgHeight.ToString(System.Globalization.CultureInfo.InvariantCulture)}\" style=\"width:100%;display:block\">");

        // рёбра
        for (int i = 1; i < nodeParent.Count; i++)
        {
            int p = nodeParent[i];
            var (x1, y1) = nodePos[p];
            var (x2, y2) = nodePos[i];
            bool green = vizVisited.Contains(p) && vizVisited.Contains(i);
            string stroke = green ? "#10b981" : "#4b5563";
            sb.Append($"<line x1=\"{F(x1)}\" y1=\"{F(y1)}\" x2=\"{F(x2)}\" y2=\"{F(y2)}\" stroke=\"{stroke}\" stroke-width=\"2\"/>");
        }

        // узлы
        for (int i = 0; i < nodeParent.Count; i++)
        {
            var (cx, cy) = nodePos[i];
            string fill = NodeColor(i);
            sb.Append($"<circle cx=\"{F(cx)}\" cy=\"{F(cy)}\" r=\"20\" fill=\"{fill}\" stroke=\"#1f2937\" stroke-width=\"2\"/>");
            sb.Append($"<text x=\"{F(cx)}\" y=\"{F(cy + 5)}\" text-anchor=\"middle\" fill=\"white\" font-size=\"13\" font-weight=\"bold\">{i}</text>");
        }

        sb.Append("</svg>");
        return sb.ToString();

        static string F(double v) =>
            v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
    }


    // ── Бенчмарк ─────────────────────────────────────────────

    int maxN = 5000;
    int benchStep = 200;
    bool benchRunning = false;
    string saved = "";
    string benchError = "";
    int currentBenchN = 0;
    double progress = 0;

    List<BenchmarkPoint> benchPoints = new();
    ApproximationResult approximation = new();

    string ProgressStyle =>
        $"width:{progress.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}%;";

    async Task RunBenchmark()
    {
        if (benchRunning) return;

        benchRunning = true;
        saved = "";
        benchError = "";
        benchPoints.Clear();
        approximation = new();
        progress = 0;

        var rng = new Random();
        var sizes = BuildSizes(maxN, benchStep);
        int completed = 0;

        try
        {
            foreach (int n in sizes)
            {
                currentBenchN = n;
                var adj = BuildGraph(n, rng);

                double total = 0;
                for (int r = 0; r < Runs; r++)
                {
                    var sw = Stopwatch.StartNew();
                    BfsAlgo(adj, n);
                    sw.Stop();
                    total += sw.Elapsed.TotalMilliseconds;
                }

                benchPoints.Add(new BenchmarkPoint
                {
                    N = n,
                    TimeMs = total / Runs
                });

                completed++;
                progress = (double)completed / sizes.Count * 100;
                StateHasChanged();
                await Task.Yield();
            }

            approximation = ApproximationService.Fit(benchPoints, ComplexityType.Linear);

            await SaveService.SaveAsync(
                "bfs", "Обход в ширину (BFS)", "O(V+E)",
                maxN, benchStep, Runs,
                benchPoints, approximation);

            saved = "Эксперимент сохранён.";
        }
        catch (Exception ex)
        {
            benchError = ex.Message;
        }
        finally
        {
            progress = 100;
            benchRunning = false;
            currentBenchN = 0;
        }
    }

    static List<int> BuildSizes(int max, int step)
    {
        var result = new List<int>();
        for (int n = step; n <= max; n += step) result.Add(n);
        if (result.Count == 0 || result[^1] != max) result.Add(max);
        return result;
    }

    static List<List<int>> BuildGraph(int n, Random rng)
    {
        var adj = new List<List<int>>(n);
        for (int i = 0; i < n; i++) adj.Add(new List<int>());

        for (int i = 1; i < n; i++)
        {
            adj[i - 1].Add(i);
            adj[i].Add(i - 1);
        }
        for (int e = 0; e < n; e++)
        {
            int u = rng.Next(n), v = rng.Next(n);
            if (u != v) { adj[u].Add(v); adj[v].Add(u); }
        }
        return adj;
    }

    static void BfsAlgo(List<List<int>> adj, int n)
    {
        var visited = new bool[n];
        var q = new Queue<int>();
        visited[0] = true;
        q.Enqueue(0);
        while (q.Count > 0)
        {
            int v = q.Dequeue();
            foreach (int u in adj[v])
                if (!visited[u]) { visited[u] = true; q.Enqueue(u); }
        }
    }
}
