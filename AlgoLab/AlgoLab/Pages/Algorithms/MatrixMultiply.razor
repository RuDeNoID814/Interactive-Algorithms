@using System.Diagnostics
@using Microsoft.JSInterop

@inject ExperimentSaveService SaveService
@inject IJSRuntime JS


<h3>Классическое умножение матриц</h3>

<p>
    Классическое умножение матриц выполняется
    с помощью трёх вложенных циклов.
</p>


<div class="alert alert-info">

    <strong>Квадратные матрицы:</strong>
    O(n³)

    <br />

    <strong>Матрицы A(n×m) и B(m×n):</strong>
    O(n²·m)

</div>


<!-- ================================================= -->
<!-- 2D                                               -->
<!-- ================================================= -->

<hr class="my-4" />


<h3>
    2D-анализ
</h3>


<p>
    Эксперимент для квадратных матриц
    A(n×n) и B(n×n).
</p>


<div class="row">


    <div class="col-md-4 mb-3">

        <label class="form-label">
            Максимальное n
        </label>

        <input type="number"
               class="form-control"
               min="1"
               @bind="maxN2D"
               disabled="@AnyRunning" />

    </div>


    <div class="col-md-4 mb-3">

        <label class="form-label">
            Шаг
        </label>

        <input type="number"
               class="form-control"
               min="1"
               @bind="step2D"
               disabled="@AnyRunning" />

    </div>


    <div class="col-md-4 mb-3">

        <label class="form-label">
            Запусков
        </label>

        <input class="form-control"
               value="@Runs"
               disabled />

    </div>


</div>


@if (maxN2D >= 500)
{
    <div class="alert alert-warning">

        Сложность O(n³). Большие размеры
        могут вычисляться продолжительное время.

    </div>
}


<button class="btn btn-success"
        @onclick="Run2D"
        disabled="@AnyRunning">

    @(running2D
        ? "2D-эксперимент выполняется..."
        : "Запустить 2D-эксперимент")

</button>


@if (running2D)
{
    <div class="mt-4">

        <div class="d-flex justify-content-between">

            <span>
                n = @currentN,
                запуск @currentRun из @Runs
            </span>

            <strong>
                @progress2D.ToString("F1")%
            </strong>

        </div>


        <div class="progress mt-2"
             style="height:25px;">

            <div class="
                progress-bar
                progress-bar-striped
                progress-bar-animated"
                 style="@Progress2DStyle">

                @progress2D.ToString("F0")%

            </div>

        </div>

    </div>
}


@if (points2D.Count > 0)
{
    <div class="mt-5">

        <ComplexityChart Experimental="@points2D"
                         Approximation="@approximation2D.Points"
                         Title="Умножение квадратных матриц"
                         ApproximationName="Аппроксимация C·n³"
                         XAxisTitle="Размер квадратной матрицы n"
                         YAxisTitle="Среднее время выполнения, мс"
                         Height="520" />


        <div class="alert alert-light border mt-4">

            <strong>
                Аппроксимация:
            </strong>

            T(n) ≈
            @approximation2D.Coefficient.ToString("G6")
            · n³

            <br />

            <strong>
                R²:
            </strong>

            @approximation2D.R2.ToString("F4")

        </div>

    </div>
}


<!-- ================================================= -->
<!-- 3D                                               -->
<!-- ================================================= -->

<hr class="my-5" />


<h3>
    3D-анализ
</h3>


<div class="alert alert-secondary">

    Используются матрицы:

    <br />

    <strong>
        A = n × m
    </strong>

    <br />

    <strong>
        B = m × n
    </strong>

    <br />

    <strong>
        C = n × n
    </strong>

    <br /><br />

    Для каждой пары (n,m) выполняется
    пять независимых замеров.

</div>


<div class="row">


    <div class="col-md-3 mb-3">

        <label class="form-label">
            Максимальное n
        </label>

        <input type="number"
               class="form-control"
               min="1"
               @bind="maxN3D"
               disabled="@AnyRunning" />

    </div>


    <div class="col-md-3 mb-3">

        <label class="form-label">
            Шаг n
        </label>

        <input type="number"
               class="form-control"
               min="1"
               @bind="stepN3D"
               disabled="@AnyRunning" />

    </div>


    <div class="col-md-3 mb-3">

        <label class="form-label">
            Максимальное m
        </label>

        <input type="number"
               class="form-control"
               min="1"
               @bind="maxM3D"
               disabled="@AnyRunning" />

    </div>


    <div class="col-md-3 mb-3">

        <label class="form-label">
            Шаг m
        </label>

        <input type="number"
               class="form-control"
               min="1"
               @bind="stepM3D"
               disabled="@AnyRunning" />

    </div>


</div>


@if (maxN3D >= 500 ||
     maxM3D >= 500)
{
    <div class="alert alert-warning">

        Поверхность может потребовать большое
        количество вычислений.

    </div>
}


@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">
        @error
    </div>
}


<button class="btn btn-primary"
        @onclick="Run3D"
        disabled="@AnyRunning">

    @(running3D
        ? "3D-эксперимент выполняется..."
        : "Запустить 3D-эксперимент")

</button>


@if (running3D)
{
    <div class="mt-4">


        <div class="d-flex justify-content-between">

            <span>

                n =
                <strong>@currentN</strong>,

                m =
                <strong>@currentM</strong>,

                запуск

                <strong>@currentRun</strong>

                из @Runs

            </span>


            <strong>
                @progress3D.ToString("F1")%
            </strong>

        </div>


        <div class="progress mt-2"
             style="height:25px;">

            <div class="
                progress-bar
                progress-bar-striped
                progress-bar-animated
                bg-primary"
                 style="@Progress3DStyle">

                @progress3D.ToString("F0")%

            </div>

        </div>


        <small class="text-muted">

            Комбинаций:
            @completedPairs /
            @totalPairs

        </small>

    </div>
}


@if (!string.IsNullOrWhiteSpace(saved3D))
{
    <div class="alert alert-success mt-3">

        @saved3D

        <a href="/history"
           class="alert-link ms-2">

            Открыть историю

        </a>

    </div>
}


@if (hasSurface)
{
    <div class="mt-5">


        <h4>
            3D-поверхность
        </h4>


        <p class="text-muted">

            X — размер n.

            Y — размер m.

            Z — среднее время выполнения.

        </p>


        <div id="@surfaceId"
             style="
            width:100%;
            min-height:650px;
            border:1px solid #e5e7eb;
            border-radius:8px;">
        </div>


        @if (!string.IsNullOrWhiteSpace(plotError))
        {
            <div class="alert alert-warning mt-2">

                @plotError

            </div>
        }


        <div class="alert alert-light border mt-4">

            Для A(n×m) и B(m×n)
            вычисляется n² элементов результата,
            для каждого из которых выполняется m
            умножений.

            <br />

            <strong>
                T(n,m) = O(n²·m)
            </strong>

            <br />

            При n=m:

            <strong>
                O(n³)
            </strong>.

        </div>


        <div class="table-responsive mt-4">

            <table class="
                table
                table-sm
                table-striped">

                <thead>

                    <tr>

                        <th>
                            n
                        </th>

                        <th>
                            m
                        </th>

                        <th>
                            Среднее время, мс
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var point
                        in surfacePoints
                            .OrderBy(p => p.N)
                            .ThenBy(p => p.M))
                    {
                        <tr>

                            <td>
                                @point.N
                            </td>

                            <td>
                                @point.M
                            </td>

                            <td>
                                @point.TimeMs.ToString("F6")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


    </div>
}


@code {

    private const int Runs = 5;


    // =====================================================
    // 2D
    // =====================================================

    private int maxN2D = 200;

    private int step2D = 10;


    private bool running2D;

    private double progress2D;


    private List<BenchmarkPoint> points2D =
        new();


    private ApproximationResult approximation2D =
        new();


    // =====================================================
    // 3D
    // =====================================================

    private int maxN3D = 100;

    private int stepN3D = 10;


    private int maxM3D = 100;

    private int stepM3D = 10;


    private bool running3D;


    private double progress3D;


    private int totalPairs;

    private int completedPairs;


    private List<int> surfaceN =
        new();


    private List<int> surfaceM =
        new();


    private double[][] surfaceZ =
        Array.Empty<double[]>();


    private List<MatrixSurfacePoint> surfacePoints =
        new();


    private bool hasSurface;

    private bool drawSurface;


    // =====================================================
    // COMMON STATE
    // =====================================================

    private int currentN;

    private int currentM;

    private int currentRun;


    private string error = "";

    private string plotError = "";

    private string saved3D = "";


    private readonly string surfaceId =
        "matrix-surface-"
        + Guid.NewGuid().ToString("N");


    private bool AnyRunning =>
        running2D ||
        running3D;


    // =====================================================
    // 2D
    // =====================================================

    private async Task Run2D()
    {
        if (AnyRunning)
            return;


        if (maxN2D < 1 ||
            step2D < 1)
        {
            error =
                "Параметры 2D должны быть больше нуля.";

            return;
        }


        error = "";

        running2D = true;

        progress2D = 0;


        points2D.Clear();


        var sizes =
            BuildValues(
                maxN2D,
                step2D);


        var random =
            new Random();


        int completed =
            0;


        try
        {

            foreach (int n in sizes)
            {
                currentN =
                    n;


                var a =
                    GenerateMatrix(
                        n,
                        n,
                        random);


                var b =
                    GenerateMatrix(
                        n,
                        n,
                        random);


                double total =
                    0;


                for (int run = 1;
                     run <= Runs;
                     run++)
                {
                    currentRun =
                        run;


                    var sw =
                        Stopwatch.StartNew();


                    Multiply(
                        a,
                        b);


                    sw.Stop();


                    total +=
                        sw.Elapsed.TotalMilliseconds;


                    progress2D =
                        (completed
                         + (double)run / Runs)
                        * 100
                        / sizes.Count;


                    StateHasChanged();

                    await Task.Yield();
                }


                points2D.Add(
                    new BenchmarkPoint
                    {
                        N = n,

                        TimeMs =
                            total / Runs
                    });


                completed++;
            }


            approximation2D =
                ApproximationService.Fit(
                    points2D,
                    ComplexityType.Cubic);


            progress2D =
                100;


            await SaveService.SaveAsync(
                slug:
                    "matrix",

                name:
                    "Умножение квадратных матриц",

                complexity:
                    "O(n³)",

                maxN:
                    maxN2D,

                step:
                    step2D,

                runs:
                    Runs,

                points:
                    points2D,

                approximation:
                    approximation2D);
        }
        catch (Exception ex)
        {
            error =
                ex.Message;
        }
        finally
        {
            running2D =
                false;


            currentN =
                0;


            currentRun =
                0;
        }
    }


    // =====================================================
    // 3D
    // =====================================================

    private async Task Run3D()
    {
        if (AnyRunning)
            return;


        if (maxN3D < 1 ||
            maxM3D < 1 ||
            stepN3D < 1 ||
            stepM3D < 1)
        {
            error =
                "Все параметры 3D должны быть больше нуля.";

            return;
        }


        error = "";

        plotError = "";

        saved3D = "";


        running3D =
            true;


        progress3D =
            0;


        hasSurface =
            false;


        drawSurface =
            false;


        surfacePoints.Clear();


        surfaceN =
            BuildValues(
                maxN3D,
                stepN3D);


        surfaceM =
            BuildValues(
                maxM3D,
                stepM3D);


        totalPairs =
            surfaceN.Count
            * surfaceM.Count;


        completedPairs =
            0;


        var rows =
            new List<double[]>();


        var random =
            new Random();


        try
        {

            foreach (int m
                     in surfaceM)
            {
                var row =
                    new double[
                        surfaceN.Count];


                for (int nIndex = 0;
                     nIndex < surfaceN.Count;
                     nIndex++)
                {
                    int n =
                        surfaceN[nIndex];


                    currentN =
                        n;


                    currentM =
                        m;


                    var a =
                        GenerateMatrix(
                            n,
                            m,
                            random);


                    var b =
                        GenerateMatrix(
                            m,
                            n,
                            random);


                    double total =
                        0;


                    for (int run = 1;
                         run <= Runs;
                         run++)
                    {
                        currentRun =
                            run;


                        var sw =
                            Stopwatch.StartNew();


                        Multiply(
                            a,
                            b);


                        sw.Stop();


                        total +=
                            sw.Elapsed.TotalMilliseconds;


                        progress3D =
                            (completedPairs
                             + (double)run / Runs)
                            * 100
                            / totalPairs;


                        StateHasChanged();

                        await Task.Yield();
                    }


                    double average =
                        total / Runs;


                    row[nIndex] =
                        average;


                    surfacePoints.Add(
                        new MatrixSurfacePoint
                        {
                            N =
                                n,

                            M =
                                m,

                            TimeMs =
                                average
                        });


                    completedPairs++;


                    progress3D =
                        completedPairs
                        * 100.0
                        / totalPairs;


                    StateHasChanged();

                    await Task.Yield();
                }


                rows.Add(
                    row);
            }


            surfaceZ =
                rows.ToArray();


            progress3D =
                100;


            hasSurface =
                true;


            drawSurface =
                true;


            StateHasChanged();

            await Task.Yield();


            // Отдельная запись истории.

            await SaveService.SaveAsync(
                slug:
                    "matrix-3d",

                name:
                    "Умножение матриц — 3D",

                complexity:
                    "O(n²·m)",

                maxN:
                    maxN3D,

                step:
                    stepN3D,

                runs:
                    Runs,

                points:
                    Array.Empty<BenchmarkPoint>(),

                approximation:
                    new ApproximationResult(),

                surfacePoints:
                    surfacePoints);


            saved3D =
                "3D-эксперимент сохранён в историю.";
        }
        catch (Exception ex)
        {
            error =
                ex.Message;
        }
        finally
        {
            running3D =
                false;


            currentN =
                0;


            currentM =
                0;


            currentRun =
                0;


            StateHasChanged();
        }
    }


    // =====================================================
    // PLOTLY
    // =====================================================

    protected override async Task
        OnAfterRenderAsync(
            bool firstRender)
    {
        if (!drawSurface)
            return;


        drawSurface =
            false;


        try
        {
            await JS.InvokeVoidAsync(
                "algoLabPlotly.drawMatrixSurface",
                surfaceId,
                surfaceN,
                surfaceM,
                surfaceZ);
        }
        catch (Exception ex)
        {
            plotError =
                ex.Message;


            StateHasChanged();
        }
    }


    // =====================================================
    // MATRIX
    // =====================================================

    private static double[,]
        GenerateMatrix(
            int rows,
            int columns,
            Random random)
    {
        var result =
            new double[
                rows,
                columns];


        for (int i = 0;
             i < rows;
             i++)
        {
            for (int j = 0;
                 j < columns;
                 j++)
            {
                result[i, j] =
                    random.NextDouble()
                    * 100;
            }
        }


        return result;
    }


    private static double[,]
        Multiply(
            double[,] a,
            double[,] b)
    {
        int rows =
            a.GetLength(0);


        int common =
            a.GetLength(1);


        if (common !=
            b.GetLength(0))
        {
            throw new ArgumentException(
                "Несовместимые размеры матриц.");
        }


        int columns =
            b.GetLength(1);


        var result =
            new double[
                rows,
                columns];


        for (int i = 0;
             i < rows;
             i++)
        {
            for (int j = 0;
                 j < columns;
                 j++)
            {
                double sum =
                    0;


                for (int k = 0;
                     k < common;
                     k++)
                {
                    sum +=
                        a[i, k]
                        *
                        b[k, j];
                }


                result[i, j] =
                    sum;
            }
        }


        return result;
    }


    // =====================================================
    // VALUES
    // =====================================================

    private static List<int>
        BuildValues(
            int maximum,
            int step)
    {
        var result =
            new List<int>();


        for (int value = 1;
             value <= maximum;
             value += step)
        {
            result.Add(
                value);
        }


        if (result.Count == 0 ||
            result[^1] != maximum)
        {
            result.Add(
                maximum);
        }


        return result;
    }


    // =====================================================
    // CSS
    // =====================================================

    private string Progress2DStyle =>
        ProgressStyle(
            progress2D);


    private string Progress3DStyle =>
        ProgressStyle(
            progress3D);


    private static string ProgressStyle(
        double value)
    {
        string width =
            value.ToString(
                "F1",
                System.Globalization
                    .CultureInfo
                    .InvariantCulture);


        return $"width:{width}%;";
    }
}