<div>

    <h3>Умножение матриц</h3>

    <p>
        Классический алгоритм умножения двух квадратных матриц.
        Каждый элемент результирующей матрицы вычисляется как
        скалярное произведение строки матрицы A и столбца матрицы B.
    </p>

    <div class="alert alert-info">
        <strong>Временная сложность:</strong> O(n³)
        <br />
        <strong>Память для результата:</strong> O(n²)
    </div>


    <!-- ================================= -->
    <!-- НАСТРОЙКИ                        -->
    <!-- ================================= -->

    <h4 class="mt-4">Визуализация алгоритма</h4>

    <div class="mb-3">

        <label class="form-label">
            Размер матриц:
            <strong>@matrixSize × @matrixSize</strong>
        </label>

        <input type="range"
               class="form-range"
               min="2"
               max="6"
               @bind="matrixSize"
               disabled="@isRunning" />

        <small class="text-muted">
            Для визуализации размер ограничен до 6×6.
        </small>

    </div>


    <div class="mb-3">

        <label class="form-label">
            Скорость анимации:
            <strong>@GetSpeedText()</strong>
        </label>

        <input type="range"
               class="form-range"
               min="1"
               max="5"
               @bind="animationSpeed"
               disabled="@isRunning" />

    </div>


    <div class="d-flex gap-2 mb-4">

        <button class="btn btn-secondary"
                @onclick="GenerateMatrices"
                disabled="@isRunning">
            Новые матрицы
        </button>

        <button class="btn btn-primary"
                @onclick="MultiplyAnimated"
                disabled="@(isRunning || calculationFinished)">
            @(isRunning ? "Вычисление..." : "Умножить A × B")
        </button>

    </div>


    <!-- ================================= -->
    <!-- МАТРИЦЫ                          -->
    <!-- ================================= -->
    @if (matrixA.GetLength(0) > 0)
    {
        <div style="
            display:flex;
            align-items:center;
            justify-content:center;
            flex-wrap:wrap;
            gap:25px;
            overflow-x:auto;">

            <!-- A -->

            <div>

                <h5 class="text-center">
                    Матрица A
                </h5>

                <table style="
                    border-collapse:separate;
                    border-spacing:4px;">

                    @for (int i = 0;
                          i < matrixA.GetLength(0);
                          i++)
                    {
                        int row = i;

                        <tr>

                            @for (int j = 0;
                                  j < matrixA.GetLength(1);
                                  j++)
                            {
                                int col = j;

                                <td style="@GetAStyle(row, col)">
                                    @matrixA[row, col]
                                </td>
                            }

                        </tr>
                    }

                </table>

            </div>


            <div style="
                font-size:30px;
                font-weight:bold;">
                ×
            </div>


            <!-- B -->

            <div>

                <h5 class="text-center">
                    Матрица B
                </h5>

                <table style="
                    border-collapse:separate;
                    border-spacing:4px;">

                    @for (int i = 0;
                          i < matrixB.GetLength(0);
                          i++)
                    {
                        int row = i;

                        <tr>

                            @for (int j = 0;
                                  j < matrixB.GetLength(1);
                                  j++)
                            {
                                int col = j;

                                <td style="@GetBStyle(row, col)">
                                    @matrixB[row, col]
                                </td>
                            }

                        </tr>
                    }

                </table>

            </div>


            <div style="
                font-size:30px;
                font-weight:bold;">
                =
            </div>


            <!-- C -->

            <div>

                <h5 class="text-center">
                    Матрица C
                </h5>

                <table style="
                    border-collapse:separate;
                    border-spacing:4px;">

                    @for (int i = 0;
                          i < matrixC.GetLength(0);
                          i++)
                    {
                        int row = i;

                        <tr>

                            @for (int j = 0;
                                  j < matrixC.GetLength(1);
                                  j++)
                            {
                                int col = j;

                                <td style="@GetCStyle(row, col)">
                                    @matrixC[row, col]
                                </td>
                            }

                        </tr>
                    }

                </table>

            </div>

        </div>


        <!-- Легенда -->

        <div class="d-flex justify-content-center
            flex-wrap gap-4 mt-4">

            <span>
                <span style="color:#ef4444">■</span>
                Строка A
            </span>

            <span>
                <span style="color:#f59e0b">■</span>
                Столбец B
            </span>

            <span>
                <span style="color:#22c55e">■</span>
                Ячейка C
            </span>

        </div>


        <!-- Текущее вычисление -->

        <div class="text-center mt-4"
             style="min-height:70px;">

            @if (isRunning)
            {
                <div>
                    Вычисляем
                    <strong>
                        C[@currentI,@currentJ]
                    </strong>
                </div>

                <div class="mt-2">

                    @matrixA[currentI, currentK]

                    ×

                    @matrixB[currentK, currentJ]

                    =

                    @(matrixA[currentI, currentK]
                        * matrixB[currentK, currentJ])

                </div>

                <div class="text-muted">

                    Текущая сумма:
                    @matrixC[currentI, currentJ]

                </div>
            }
            else if (calculationFinished)
            {
                <strong class="text-success">
                    Умножение завершено
                </strong>
            }
            else
            {
                <span class="text-muted">
                    Нажмите «Умножить A × B»
                </span>
            }

        </div>


        <!-- СТАТИСТИКА -->

        <div class="row mt-4">

            <div class="col-md-4 mb-2">

                <div class="card h-100">
                    <div class="card-body">

                        <small class="text-muted">
                            Умножений
                        </small>

                        <h4>@multiplications</h4>

                    </div>
                </div>

            </div>


            <div class="col-md-4 mb-2">

                <div class="card h-100">
                    <div class="card-body">

                        <small class="text-muted">
                            Сложений
                        </small>

                        <h4>@additions</h4>

                    </div>
                </div>

            </div>


            <div class="col-md-4 mb-2">

                <div class="card h-100">
                    <div class="card-body">

                        <small class="text-muted">
                            Размер
                        </small>

                        <h4>
                            @matrixA.GetLength(0)
                            ×
                            @matrixA.GetLength(0)
                        </h4>

                    </div>
                </div>

            </div>

        </div>


        <div class="alert alert-secondary mt-4">

            <strong>Как вычисляется элемент?</strong>

            <p class="mt-2 mb-1">
                Для каждого элемента C[i,j]:
            </p>

            <code>
                C[i,j] = Σ A[i,k] × B[k,j]
            </code>

            <p class="mt-2 mb-0">
                Алгоритм использует три вложенных цикла
                по i, j и k, поэтому его временная
                сложность составляет <strong>O(n³)</strong>.
            </p>

        </div>
    }

</div>


@code {

    private int matrixSize = 3;

    private int animationSpeed = 3;

    private int[,] matrixA = new int[0, 0];

    private int[,] matrixB = new int[0, 0];

    private int[,] matrixC = new int[0, 0];


    private bool isRunning;

    private bool calculationFinished;


    // Текущие индексы i, j, k.
    private int currentI = -1;

    private int currentJ = -1;

    private int currentK = -1;


    private long multiplications;

    private long additions;


    protected override void OnInitialized()
    {
        GenerateMatrices();
    }


    // ======================================
    // ГЕНЕРАЦИЯ
    // ======================================

    private void GenerateMatrices()
    {
        var random = new Random();

        matrixA =
            new int[matrixSize, matrixSize];

        matrixB =
            new int[matrixSize, matrixSize];

        matrixC =
            new int[matrixSize, matrixSize];


        for (int i = 0;
             i < matrixSize;
             i++)
        {
            for (int j = 0;
                 j < matrixSize;
                 j++)
            {
                // Небольшие числа специально
                // используются для наглядности.

                matrixA[i, j] =
                    random.Next(1, 10);

                matrixB[i, j] =
                    random.Next(1, 10);
            }
        }


        multiplications = 0;

        additions = 0;


        currentI = -1;

        currentJ = -1;

        currentK = -1;


        isRunning = false;

        calculationFinished = false;
    }


    // ======================================
    // АНИМИРОВАННОЕ УМНОЖЕНИЕ
    // ======================================

    private async Task MultiplyAnimated()
    {
        if (isRunning)
            return;


        isRunning = true;

        calculationFinished = false;


        multiplications = 0;

        additions = 0;


        int n =
            matrixA.GetLength(0);


        // Очищаем C перед вычислением.
        matrixC =
            new int[n, n];


        // Классический алгоритм O(n³).
        for (int i = 0;
             i < n;
             i++)
        {
            for (int j = 0;
                 j < n;
                 j++)
            {
                for (int k = 0;
                     k < n;
                     k++)
                {
                    currentI = i;

                    currentJ = j;

                    currentK = k;


                    StateHasChanged();

                    await Task.Delay(
                        GetDelay());


                    int product =
                        matrixA[i, k]
                        *
                        matrixB[k, j];


                    matrixC[i, j] +=
                        product;


                    multiplications++;

                    additions++;


                    StateHasChanged();

                    await Task.Delay(
                        GetDelay());
                }
            }
        }


        currentI = -1;

        currentJ = -1;

        currentK = -1;


        isRunning = false;

        calculationFinished = true;


        StateHasChanged();
    }


    // ======================================
    // ЦВЕТА
    // ======================================

    private string GetAStyle(
        int row,
        int col)
    {
        string color = "#f3f4f6";

        string textColor = "#111827";


        // Выделяем всю используемую строку.
        if (isRunning &&
            row == currentI)
        {
            color = "#fecaca";
        }


        // Текущий элемент делаем ярче.
        if (isRunning &&
            row == currentI &&
            col == currentK)
        {
            color = "#ef4444";
            textColor = "white";
        }


        return CellStyle(
            color,
            textColor);
    }


    private string GetBStyle(
        int row,
        int col)
    {
        string color = "#f3f4f6";

        string textColor = "#111827";


        // Выделяем используемый столбец.
        if (isRunning &&
            col == currentJ)
        {
            color = "#fde68a";
        }


        if (isRunning &&
            row == currentK &&
            col == currentJ)
        {
            color = "#f59e0b";
            textColor = "white";
        }


        return CellStyle(
            color,
            textColor);
    }


    private string GetCStyle(
        int row,
        int col)
    {
        string color = "#f3f4f6";

        string textColor = "#111827";


        if (isRunning &&
            row == currentI &&
            col == currentJ)
        {
            color = "#22c55e";
            textColor = "white";
        }


        return CellStyle(
            color,
            textColor);
    }


    private static string CellStyle(
        string background,
        string color)
    {
        return $"""
            width:48px;
            height:48px;
            text-align:center;
            vertical-align:middle;
            font-weight:600;
            border-radius:6px;
            background:{background};
            color:{color};
            transition:background 0.15s ease;
            """;
    }


    // ======================================
    // СКОРОСТЬ
    // ======================================

    private int GetDelay()
    {
        return animationSpeed switch
        {
            1 => 700,
            2 => 400,
            3 => 220,
            4 => 100,
            5 => 30,
            _ => 220
        };
    }


    private string GetSpeedText()
    {
        return animationSpeed switch
        {
            1 => "Очень медленно",
            2 => "Медленно",
            3 => "Средне",
            4 => "Быстро",
            5 => "Очень быстро",
            _ => "Средне"
        };
    }
}