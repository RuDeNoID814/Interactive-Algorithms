@using System.Diagnostics
@using Microsoft.JSInterop
@inherits AlgorithmExperimentBase

@inject IJSRuntime JS

<h3>Классическое умножение матриц</h3>
<p>Для двух квадратных матриц A и B размера n×n вычисляется произведение C = A × B.</p>

<div class="alert alert-info">
    <strong>Временная сложность:</strong> O(n³)<br />
    <strong>Дополнительная память:</strong> O(n²)<br />
    <strong>Структура алгоритма:</strong> три вложенных цикла
</div>

<hr />
<h3>Экспериментальный анализ</h3>

<p>Для каждого размера генерируются две случайные матрицы. Алгоритм запускается пять раз.</p>

<div class="row">
    <div class="col-md-4 mb-3">
        <label>Максимальное n</label>
        <input type="number" min="1" class="form-control" @bind="MaxN" disabled="@Running" />
    </div>
    <div class="col-md-4 mb-3">
        <label>Шаг</label>
        <input type="number" min="1" class="form-control" @bind="Step" disabled="@Running" />
    </div>
    <div class="col-md-4 mb-3">
        <label>Запусков</label>
        <input class="form-control" value="@Runs" disabled />
    </div>
</div>

@if (MaxN >= 500)
{
    <div class="alert alert-warning">
        <strong>Предупреждение.</strong> Алгоритм имеет сложность O(n³). Большие матрицы могут выполняться продолжительное время.
    </div>
}

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}

<button class="btn btn-success" @onclick="OnRunClicked" disabled="@Running">
    @(Running ? "Эксперимент выполняется..." : "Запустить эксперимент")
</button>

@if (Running)
{
    <div class="mt-4">
        <div class="d-flex justify-content-between">
            <span>n = <strong>@CurrentN</strong>, запуск <strong>@CurrentRun</strong> из @Runs</span>
            <strong>@Progress.ToString("F1")%</strong>
        </div>
        <div class="progress mt-2" style="height:25px">
            <div class="progress-bar progress-bar-striped progress-bar-animated" style="@ProgressStyle">
                @Progress.ToString("F0")%
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Saved))
{
    <div class="alert alert-success mt-3">
        @Saved <a href="/history" class="alert-link ms-2">Открыть историю</a>
    </div>
}

@if (Points.Count > 0)
{
    <div class="mt-5">
        <h4>Среднее время выполнения</h4>

        <ComplexityChart Experimental="@Points"
                         Approximation="@Approximation.Points"
                         Title="Умножение матриц — временная сложность"
                         ApproximationName="Аппроксимация C·n³"
                         XAxisTitle="Размер матрицы n"
                         YAxisTitle="Среднее время выполнения, мс"
                         Height="520" />

        <div class="alert alert-light border mt-4">
            <h5>Аппроксимация</h5>
            <div style="font-family:monospace;font-size:1.15rem;">
                T(n) ≈ @Approximation.Coefficient.ToString("G6") · n³
            </div>
            <div class="mt-2">
                R² = <strong>@Approximation.R2.ToString("F4")</strong>
            </div>
        </div>

        <div class="mt-5">
            <h4>Трёхмерный график пяти запусков</h4>
            <p class="text-muted">
                <strong>X:</strong> размер матрицы n<br />
                <strong>Y:</strong> номер запуска от 1 до 5<br />
                <strong>Z:</strong> машинное время выполнения, мс
            </p>

            <div id="@plotId" style="width:100%;min-height:600px;border:1px solid #e5e7eb;border-radius:8px;"></div>

            @if (!string.IsNullOrWhiteSpace(plotError))
            {
                <div class="alert alert-warning mt-2">Ошибка 3D-графика: @plotError</div>
            }
        </div>

        <div class="alert alert-secondary mt-5">
            <strong>Теоретический анализ</strong>
            <p class="mt-2 mb-1">Используются три вложенных цикла:</p>
            <code>
                for i = 0..n-1<br />
                &nbsp;&nbsp;for j = 0..n-1<br />
                &nbsp;&nbsp;&nbsp;&nbsp;for k = 0..n-1
            </code>
            <p class="mt-2 mb-0">Следовательно: <strong>T(n) = O(n³)</strong>.</p>
        </div>

        <div class="mt-4">
            <h4>Последние отдельные замеры</h4>
            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <thead>
                        <tr><th>n</th><th>Запуск</th><th>Время, мс</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var point in runPoints.TakeLast(Math.Min(50, runPoints.Count)))
                        {
                            <tr>
                                <td>@point.N</td>
                                <td>@point.Run</td>
                                <td>@point.TimeMs.ToString("F6")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<CachePromptDialog Show="ShowCachePrompt" Experiment="CachedExperiment"
                   OnUseCache="UseCachedResult" OnRecalculate="ForceRecalculate" />

@code {
    protected override string AlgorithmSlug => "matrix";
    protected override string AlgorithmName => "Умножение матриц";
    protected override string AlgorithmComplexity => "O(n³)";
    protected override ComplexityType ComplexityType => ComplexityType.Cubic;

    protected override int MaxN { get; set; } = 200;
    protected override int Step { get; set; } = 10;

    private List<BenchmarkPoint> runPoints = new();
    private string plotError = "";
    private readonly string plotId = "matrix-3d-" + Guid.NewGuid().ToString("N");
    private bool draw3D;

    protected override IReadOnlyList<BenchmarkPoint>? GetIndividualRuns() => runPoints;

    protected override void UseCachedResult()
    {
        base.UseCachedResult();
        if (CachedExperiment == null) return;

        runPoints = CachedExperiment.Points
            .Where(p => !p.IsAverage)
            .Select(p => new BenchmarkPoint { N = p.N, Run = p.Run, TimeMs = p.TimeMs })
            .ToList();

        draw3D = true;
        StateHasChanged();
    }

    protected override async Task<List<BenchmarkPoint>> RunExperimentLogicAsync(
        int maxN, int step, int runs, Action<int, int, double> updateProgress)
    {
        var averagePoints = new List<BenchmarkPoint>();
        runPoints.Clear();

        var sizes = BuildSizes(maxN, step);
        var random = new Random();
        int completed = 0;

        foreach (int n in sizes)
        {
            double[,] a = Generate(n, random);
            double[,] b = Generate(n, random);
            double total = 0;

            for (int run = 1; run <= runs; run++)
            {
                var sw = Stopwatch.StartNew();
                Multiply(a, b);
                sw.Stop();

                double time = sw.Elapsed.TotalMilliseconds;
                total += time;

                runPoints.Add(new BenchmarkPoint { N = n, Run = run, TimeMs = time });

                double progress = (completed + (double)run / runs) * 100 / sizes.Count;
                updateProgress(n, run, progress);
                await Task.Yield();
            }

            averagePoints.Add(new BenchmarkPoint { N = n, TimeMs = total / runs });
            completed++;
        }

        averagePoints = averagePoints.OrderBy(p => p.N).ToList();
        draw3D = true;
        return averagePoints;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!draw3D) return;
        draw3D = false;

        try
        {
            var data = runPoints
                .OrderBy(p => p.N)
                .ThenBy(p => p.Run)
                .Select(p => new { n = p.N, run = p.Run, timeMs = p.TimeMs })
                .ToArray();

            await JS.InvokeVoidAsync("algoLabPlotly.drawMatrix3D", plotId, data);
        }
        catch (Exception ex)
        {
            plotError = ex.Message;
            StateHasChanged();
        }
    }

    private static double[,] Generate(int n, Random random)
    {
        var matrix = new double[n, n];
        for (int i = 0; i < n; i++)
            for (int j = 0; j < n; j++)
                matrix[i, j] = random.NextDouble() * 100;
        return matrix;
    }

    private static double[,] Multiply(double[,] a, double[,] b)
    {
        int n = a.GetLength(0);
        var c = new double[n, n];
        for (int i = 0; i < n; i++)
            for (int j = 0; j < n; j++)
            {
                double sum = 0;
                for (int k = 0; k < n; k++) sum += a[i, k] * b[k, j];
                c[i, j] = sum;
            }
        return c;
    }
}