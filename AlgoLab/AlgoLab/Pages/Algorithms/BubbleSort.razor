<div class="bubble-sort">

    <h3>Демонстрация Bubble Sort</h3>

    <p>
        Сортировка пузырьком последовательно сравнивает соседние
        элементы массива и меняет их местами, если левый элемент
        больше правого.
    </p>

    <div class="alert alert-info">
        <strong>Временная сложность:</strong> O(n²)
        <br />
        <strong>Дополнительная память:</strong> O(1)
    </div>


    <!-- Настройки массива -->
    <div class="mb-3">

        <label class="form-label">
            Размер массива:
            <strong>@arraySize</strong>
        </label>

        <input type="range"
               class="form-range"
               min="5"
               max="50"
               @bind="arraySize"
               disabled="@isRunning" />

    </div>


    <!-- Скорость анимации -->
    <div class="mb-3">

        <label class="form-label">
            Скорость анимации:
            <strong>@GetSpeedText()</strong>
        </label>

        <input type="range"
               class="form-range"
               min="1"
               max="5"
               @bind="animationSpeed"
               disabled="@isRunning" />

    </div>


    <!-- Кнопки -->
    <div class="d-flex gap-2 mb-4">

        <button class="btn btn-secondary"
                @onclick="GenerateArray"
                disabled="@isRunning">
            Новые данные
        </button>

        <button class="btn btn-primary"
                @onclick="SortAnimated"
                disabled="@(isRunning || isSorted)">
            @(isRunning ? "Сортировка..." : "Сортировать")
        </button>

    </div>


    <!-- Обозначения цветов -->
    <div class="d-flex gap-4 mb-3">

        <span>
            <span style="color:#6366f1">■</span>
            Не обработан
        </span>

        <span>
            <span style="color:#ef4444">■</span>
            Сравнивается
        </span>

        <span>
            <span style="color:#22c55e">■</span>
            На своём месте
        </span>

    </div>


    <!-- Столбики массива -->
    @if (numbers.Length > 0)
    {
        <div style="
            height: 320px;
            display: flex;
            align-items: flex-end;
            gap: 4px;
            padding: 20px;
            border: 1px solid #444;
            border-radius: 8px;
            overflow: hidden;">

            @for (int i = 0; i < numbers.Length; i++)
            {
                int index = i;

                <div style="
                    flex: 1;
                    min-width: 3px;
                    height: @(numbers[index] * 2.5)px;
                    background-color: @GetBarColor(index);
                    border-radius: 4px 4px 0 0;
                    transition:
                    height 0.15s ease,
                    background-color 0.15s ease;">
                </div>
            }

        </div>


        <!-- Текущее действие -->
        <div class="mt-3 text-center">

            @if (currentLeft >= 0 && currentRight >= 0)
            {
                <span>
                    Сравниваем элементы:
                    <strong>@numbers[currentLeft]</strong>
                    и
                    <strong>@numbers[currentRight]</strong>
                </span>
            }
            else if (isSorted)
            {
                <span class="text-success">
                    Массив отсортирован
                </span>
            }
            else
            {
                <span class="text-muted">
                    Нажмите «Сортировать»
                </span>
            }

        </div>


        <!-- Статистика -->
        <div class="row mt-4">

            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">

                        <small>Сравнений</small>
                        <h4>@comparisons</h4>

                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">

                        <small>Обменов</small>
                        <h4>@swaps</h4>

                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">

                        <small>Размер массива</small>
                        <h4>@numbers.Length</h4>

                    </div>
                </div>
            </div>

        </div>
    }

</div>


@code {

    private int arraySize = 20;

    private int animationSpeed = 3;

    private int[] numbers = Array.Empty<int>();

    private long comparisons;
    private long swaps;

    private bool isSorted = true;
    private bool isRunning = false;

    // Индексы элементов, которые сейчас сравниваются.
    private int currentLeft = -1;
    private int currentRight = -1;

    // С этого индекса вправо элементы уже стоят на своих местах.
    private int sortedFrom;


    protected override void OnInitialized()
    {
        GenerateArray();
    }


    private void GenerateArray()
    {
        var random = new Random();

        numbers = Enumerable
            .Range(0, arraySize)
            .Select(_ => random.Next(10, 101))
            .ToArray();

        comparisons = 0;
        swaps = 0;

        currentLeft = -1;
        currentRight = -1;

        sortedFrom = numbers.Length;

        isSorted = false;
        isRunning = false;
    }


    private async Task SortAnimated()
    {
        if (isRunning)
            return;

        isRunning = true;
        isSorted = false;

        comparisons = 0;
        swaps = 0;

        sortedFrom = numbers.Length;

        for (int i = 0; i < numbers.Length - 1; i++)
        {
            bool swapped = false;

            for (int j = 0;
                 j < numbers.Length - i - 1;
                 j++)
            {
                currentLeft = j;
                currentRight = j + 1;

                comparisons++;

                StateHasChanged();

                await Task.Delay(GetDelay());


                if (numbers[j] > numbers[j + 1])
                {
                    (numbers[j], numbers[j + 1]) =
                        (numbers[j + 1], numbers[j]);

                    swaps++;
                    swapped = true;

                    StateHasChanged();

                    await Task.Delay(GetDelay());
                }
            }

            // После прохода максимальный элемент
            // гарантированно оказался справа.
            sortedFrom = numbers.Length - i - 1;

            StateHasChanged();


            if (!swapped)
            {
                // Если обменов не было,
                // весь оставшийся массив отсортирован.
                sortedFrom = 0;
                break;
            }
        }

        sortedFrom = 0;

        currentLeft = -1;
        currentRight = -1;

        isSorted = true;
        isRunning = false;

        StateHasChanged();
    }


    private string GetBarColor(int index)
    {
        // Красный — элементы, которые сейчас сравниваются.
        if (index == currentLeft ||
            index == currentRight)
        {
            return "#ef4444";
        }

        // Зелёный — уже отсортированная правая часть.
        if (index >= sortedFrom)
        {
            return "#22c55e";
        }

        // Фиолетовый — ещё не обработанные элементы.
        return "#6366f1";
    }


    private int GetDelay()
    {
        return animationSpeed switch
        {
            1 => 600,
            2 => 350,
            3 => 180,
            4 => 80,
            5 => 20,
            _ => 180
        };
    }


    private string GetSpeedText()
    {
        return animationSpeed switch
        {
            1 => "Очень медленно",
            2 => "Медленно",
            3 => "Средне",
            4 => "Быстро",
            5 => "Очень быстро",
            _ => "Средне"
        };
    }
}