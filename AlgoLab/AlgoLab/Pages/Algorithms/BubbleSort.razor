@using System.Diagnostics
@using AlgoLab.Components
@inherits AlgorithmExperimentBase

<h3>Пузырьковая сортировка</h3>

<p>
    Bubble Sort сравнивает соседние элементы и меняет их местами,
    если они расположены в неправильном порядке.
</p>

<div class="alert alert-info">
    <strong>Лучший случай:</strong> O(n)<br />
    <strong>Средний случай:</strong> O(n²)<br />
    <strong>Худший случай:</strong> O(n²)<br />
    <strong>Память:</strong> O(1)
</div>

<hr />

<h3>Экспериментальный анализ</h3>

<div class="row">
    <div class="col-md-4 mb-3">
        <label>Максимальное n</label>
        <input type="number" min="1" class="form-control"
               @bind="MaxN" disabled="@Running" />
    </div>

    <div class="col-md-4 mb-3">
        <label>Шаг</label>
        <input type="number" min="1" class="form-control"
               @bind="Step" disabled="@Running" />
    </div>

    <div class="col-md-4 mb-3">
        <label>Запусков</label>
        <input class="form-control" value="@Runs" disabled />
    </div>
</div>

@if (MaxN >= 10000)
{
    <div class="alert alert-warning">
        Bubble Sort имеет сложность O(n²). Большое n может
        потребовать значительного времени.
    </div>
}

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger">@Error</div>
}

<button class="btn btn-success"
        @onclick="OnRunClicked"
        disabled="@Running">
    @(Running ? "Выполняется..." : "Запустить эксперимент")
</button>

@if (Running)
{
    <div class="mt-4">
        <div class="d-flex justify-content-between">
            <span>n = @CurrentN, запуск @CurrentRun из @Runs</span>
            <strong>@Progress.ToString("F1")%</strong>
        </div>

        <div class="progress mt-2" style="height:25px">
            <div class="progress-bar progress-bar-striped progress-bar-animated"
                 style="@ProgressStyle">
                @Progress.ToString("F0")%
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Saved))
{
    <div class="alert alert-success mt-3">
        @Saved
        <a href="/history" class="alert-link ms-2">История</a>
    </div>
}

@if (Points.Count > 0)
{
    <div class="mt-5">

        <ComplexityChart Experimental="@Points"
                         Approximation="@Approximation.Points"
                         Title="Bubble Sort — временная сложность"
                         ApproximationName="Аппроксимация C·n²"
                         XAxisTitle="Размер массива n"
                         YAxisTitle="Среднее время выполнения, мс"
                         Height="520" />

        <div class="alert alert-light border mt-4">
            <strong>Аппроксимация:</strong><br />
            T(n) ≈ @Approximation.Coefficient.ToString("G6") · n²<br />
            R² = @Approximation.R2.ToString("F4")
        </div>

        <div class="alert alert-secondary">
            Количество сравнений в худшем случае:
            n(n−1)/2. Следовательно, временная сложность
            составляет <strong>O(n²)</strong>.
        </div>
    </div>
}

<!-- Подключаем модальное окно -->
<CachePromptDialog Show="ShowCachePrompt"
                   Experiment="CachedExperiment"
                   OnUseCache="UseCachedResult"
                   OnRecalculate="ForceRecalculate" />

@code {
    // Определяем метаданные алгоритма
    protected override string AlgorithmSlug => "bubble";
    protected override string AlgorithmName => "Пузырьковая сортировка";
    protected override string AlgorithmComplexity => "O(n²)";
    protected override ComplexityType ComplexityType => ComplexityType.Quadratic;

    // Реализуем только специфичную логику бенчмарка
    protected override async Task<List<BenchmarkPoint>> RunExperimentLogicAsync(
        int maxN, int step, int runs, Action<int, int, double> updateProgress)
    {
        var points = new List<BenchmarkPoint>();
        var sizes = BuildSizes(maxN, step);
        int completed = 0;
        var random = new Random();

        foreach (int n in sizes)
        {
            var original = new int[n];
            for (int i = 0; i < n; i++)
                original[i] = random.Next(100_000);

            double total = 0;

            for (int run = 1; run <= runs; run++)
            {
                var data = (int[])original.Clone();

                var sw = Stopwatch.StartNew();
                Sort(data);
                sw.Stop();

                total += sw.Elapsed.TotalMilliseconds;

                double progress = (completed + (double)run / runs) * 100 / sizes.Count;
                updateProgress(n, run, progress); // Сообщаем базовому классу о прогрессе

                await Task.Yield();
            }

            points.Add(new BenchmarkPoint
            {
                N = n,
                TimeMs = total / runs
            });

            completed++;
        }

        return points;
    }

    private static void Sort(int[] data)
    {
        for (int i = 0; i < data.Length - 1; i++)
        {
            bool swapped = false;
            for (int j = 0; j < data.Length - i - 1; j++)
            {
                if (data[j] > data[j + 1])
                {
                    (data[j], data[j + 1]) = (data[j + 1], data[j]);
                    swapped = true;
                }
            }
            if (!swapped) break;
        }
    }
}